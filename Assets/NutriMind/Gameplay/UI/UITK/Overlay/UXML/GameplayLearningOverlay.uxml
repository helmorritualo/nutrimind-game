<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.sinanata.designsystem/Resources/UI/Styles/DesignSystem/DesignSystem.uss" />
    <Style src="project://database/Assets/NutriMind/App/UI/USS/NutriMindTheme.uss" />
    <Style src="project://database/Assets/NutriMind/Gameplay/UI/UITK/Overlay/USS/GameplayLearningOverlay.uss" />

    <ui:VisualElement name="gameplay-learning-overlay-root" class="ds-root theme-nutrimind gameplay-learning-overlay gameplay-learning-overlay--hidden" picking-mode="Position">
        <ui:VisualElement name="overlay-backdrop" class="ds-backdrop gameplay-learning-overlay__backdrop">
            <ui:VisualElement name="overlay-card" class="ds-card gameplay-learning-overlay__card">
                <ui:Label name="overlay-title" text="" class="gameplay-learning-overlay__title" />
                <ui:Label name="overlay-speaker" text="" class="gameplay-learning-overlay__speaker gameplay-learning-overlay__speaker--hidden" />
                <ui:Label name="overlay-body" text="" class="gameplay-learning-overlay__body" />
                <ui:ScrollView name="overlay-options-scroll" class="gameplay-learning-overlay__options-scroll gameplay-learning-overlay__options-scroll--hidden">
                    <ui:VisualElement name="overlay-options-list" class="gameplay-learning-overlay__options-list" />
                </ui:ScrollView>
                <ui:VisualElement name="overlay-sequence-panel" class="gameplay-learning-overlay__sequence-panel gameplay-learning-overlay__sequence-panel--hidden">
                    <ui:VisualElement name="overlay-sequence-cards" class="gameplay-learning-overlay__sequence-cards" />
                    <ui:VisualElement name="overlay-sequence-slots" class="gameplay-learning-overlay__sequence-slots" />
                    <ui:Label name="overlay-sequence-hint" text="" class="gameplay-learning-overlay__sequence-hint" />
                </ui:VisualElement>
                <ui:VisualElement name="overlay-actions" class="gameplay-learning-overlay__actions">
                    <ui:Button name="overlay-reset-button" text="Reset" class="ds-button ds-button--secondary gameplay-learning-overlay__reset-button gameplay-learning-overlay__reset-button--hidden" />
                    <ui:Button name="overlay-secondary-button" text="" class="ds-button ds-button--secondary gameplay-learning-overlay__secondary-button gameplay-learning-overlay__secondary-button--hidden" />
                    <ui:Button name="overlay-confirm-button" text="Confirm" class="ds-button ds-button--primary gameplay-learning-overlay__confirm-button gameplay-learning-overlay__confirm-button--hidden" />
                    <ui:Button name="overlay-primary-button" text="Continue" class="ds-button ds-button--primary gameplay-learning-overlay__primary-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
