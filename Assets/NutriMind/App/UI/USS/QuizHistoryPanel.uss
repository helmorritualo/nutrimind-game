/* Quiz Portal history route — hosted by AppShell or standalone UIDocument preview */

.quiz-history-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    position: relative;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.quiz-history-panel.app-screen-content--embedded {
    background-color: rgba(0, 0, 0, 0);
}

.quiz-history-panel Label {
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-font-style: bold;
}

/* ========== SHELL ========== */
.quiz-history-panel__content-shell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.quiz-history-panel__content-shell.quiz-history-panel__content-shell--hidden {
    display: none;
}

/* ========== SCROLL ========== */
.quiz-history-panel__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
}

.quiz-history-panel__scroll > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.quiz-history-panel__scroll .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.quiz-history-panel__scroll .unity-scroll-view__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 100%;
    min-width: 0;
    height: auto;
}

.quiz-history-panel__body {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    height: auto;
    padding: 30px 36px 40px 36px;
}

.quiz-history-panel__bottom-spacer {
    height: 8px;
    flex-shrink: 0;
}

/* ========== DATA STATE HOST ========== */
.quiz-history-panel__data-state-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: none;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.quiz-history-panel__data-state-host.quiz-history-panel__data-state-host--visible {
    display: flex;
}

/* ========== OFFLINE NOTICE ========== */
.quiz-history-panel__offline-notice {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    margin-bottom: 24px;
    padding: 22px 26px;
    background-color: var(--color-warning-soft);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-history-panel__offline-notice.quiz-history-panel__offline-notice--hidden {
    display: none;
}

.quiz-history-panel__offline-icon {
    width: 28px;
    height: 28px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.quiz-history-panel__offline-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.quiz-history-panel__offline-title {
    font-size: 22px;
    color: var(--color-text-primary);
    margin-bottom: 8px;
}

.quiz-history-panel__offline-message {
    font-size: 19px;
    color: var(--color-text-secondary);
}

/* ========== OVERVIEW ========== */
.quiz-history-panel__overview {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
    min-height: 240px;
    margin-bottom: 26px;
    padding: 36px 40px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-history-panel__overview-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    width: 48%;
    margin-right: 28px;
}

.quiz-history-panel__overview-icon {
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--nm-literaquest);
}

.quiz-history-panel__overview-eyebrow {
    font-size: 20px;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
}

.quiz-history-panel__overview-title {
    font-size: 44px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: 12px;
    white-space: normal;
}

.quiz-history-panel__overview-description {
    font-size: 22px;
    color: var(--color-text-secondary);
    margin-bottom: 22px;
}

.quiz-history-panel__back-button {
    align-self: flex-start;
    min-height: 60px;
    padding-left: 22px;
    padding-right: 22px;
    font-size: 20px;
    color: var(--color-text-primary);
}

.quiz-history-panel__overview-metrics {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    width: 52%;
    min-width: 0;
}

.quiz-history-panel__metric-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    min-height: 136px;
    margin-right: 14px;
    padding: 22px 20px;
    background-color: var(--color-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
}

.quiz-history-panel__metric-card--last {
    margin-right: 0;
}

.quiz-history-panel__metric-value {
    font-size: 42px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: 8px;
}

.quiz-history-panel__metric-value--pass {
    color: var(--color-primary);
}

.quiz-history-panel__metric-value--score {
    color: var(--color-primary);
}

.quiz-history-panel__metric-label {
    font-size: 19px;
    color: var(--color-text-secondary);
}

/* ========== FILTER CARD ========== */
.quiz-history-panel__filter-card {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
    min-height: 120px;
    margin-bottom: 26px;
    padding: 24px 26px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-history-panel__filter-copy {
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
    margin-right: 24px;
}

.quiz-history-panel__filter-icon {
    width: 28px;
    height: 28px;
    margin-bottom: 10px;
    -unity-background-image-tint-color: var(--color-primary);
}

.quiz-history-panel__filter-title {
    font-size: 24px;
    color: var(--color-text-primary);
    margin-bottom: 6px;
}

.quiz-history-panel__filter-description {
    font-size: 18px;
    color: var(--color-text-secondary);
}

.quiz-history-panel__filter-controls {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    flex-wrap: wrap;
    min-width: 0;
}

.quiz-history-panel__filter-dropdown {
    min-width: 280px;
    min-height: 56px;
    margin-left: 12px;
    margin-bottom: 4px;
    font-size: 20px;
}

.quiz-history-panel__filter-dropdown .unity-base-field__label {
    font-size: 16px;
    min-width: 70px;
    color: var(--color-text-secondary);
}

.quiz-history-panel__filter-dropdown .unity-base-popup-field__input,
.quiz-history-panel__filter-dropdown .unity-base-field__input {
    min-height: 54px;
    font-size: 19px;
    padding-left: 14px;
    padding-right: 14px;
}

.quiz-history-panel__reset-filters {
    min-width: 160px;
    min-height: 56px;
    margin-left: 12px;
    margin-bottom: 4px;
    font-size: 19px;
    color: var(--color-text-primary);
}

/* ========== RESULTS HEADER ========== */
.quiz-history-panel__results-header {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 16px;
}

.quiz-history-panel__results-title {
    font-size: 32px;
    color: var(--color-text-primary);
}

.quiz-history-panel__visible-count {
    font-size: 19px;
    color: var(--color-text-secondary);
}

/* ========== RESULTS LIST ========== */
.quiz-history-panel__results-list {
    flex-direction: column;
    width: 100%;
    min-width: 0;
}

.quiz-history-panel__result-card {
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    min-width: 0;
    min-height: 250px;
    margin-bottom: 18px;
    padding: 32px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-history-panel__result-identity {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    justify-content: center;
    width: 45%;
    min-width: 0;
    margin-right: 20px;
}

.quiz-history-panel__result-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 14px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--nm-literaquest);
}

.quiz-history-panel__result-title {
    font-size: 32px;
    color: var(--color-text-primary);
    margin-bottom: 10px;
}

.quiz-history-panel__result-subject-term {
    font-size: 21px;
    color: var(--nm-literaquest);
    margin-bottom: 12px;
}

.quiz-history-panel__result-submitted {
    font-size: 19px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
}

.quiz-history-panel__result-chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.quiz-history-panel__result-chip {
    flex-direction: row;
    align-items: center;
    margin: 0 12px 8px 0;
    padding: 12px 16px;
    background-color: var(--color-primary-soft);
    border-radius: var(--radius-md);
}

.quiz-history-panel__result-chip--pass {
    background-color: var(--color-primary-soft);
}

.quiz-history-panel__result-chip-icon {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-secondary);
}

.quiz-history-panel__result-chip--pass .quiz-history-panel__result-chip-icon {
    -unity-background-image-tint-color: var(--color-primary);
}

.quiz-history-panel__result-chip-label {
    font-size: 18px;
    color: var(--color-text-primary);
}

.quiz-history-panel__result-score {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 25%;
    min-width: 180px;
    margin-right: 20px;
}

.quiz-history-panel__result-percentage {
    font-size: 54px;
    -unity-font-style: bold;
    color: var(--color-primary);
    margin-bottom: 8px;
}

.quiz-history-panel__result-points {
    font-size: 22px;
    color: var(--color-text-primary);
    margin-bottom: 10px;
}

.quiz-history-panel__result-counts {
    font-size: 18px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
}

.quiz-history-panel__result-action {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    width: 30%;
    min-width: 200px;
}

.quiz-history-panel__view-result-button {
    min-height: 62px;
    font-size: 21px;
    color: var(--color-text-on-accent);
}

/* ========== FILTER EMPTY ========== */
.quiz-history-panel__filter-empty {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-width: 0;
    min-height: 220px;
    margin-top: 8px;
    padding: 36px 40px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-history-panel__filter-empty.quiz-history-panel__filter-empty--hidden {
    display: none;
}

.quiz-history-panel__filter-empty-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 16px;
    -unity-background-image-tint-color: var(--color-text-secondary);
}

.quiz-history-panel__filter-empty-title {
    font-size: 28px;
    color: var(--color-text-primary);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.quiz-history-panel__filter-empty-message {
    font-size: 20px;
    color: var(--color-text-secondary);
    margin-bottom: 22px;
    -unity-text-align: middle-center;
}

.quiz-history-panel__filter-empty-reset {
    min-height: 56px;
    min-width: 180px;
    font-size: 20px;
    color: var(--color-text-primary);
}

/* ========== COMPACT < 1100 ========== */
.quiz-history-panel--compact .quiz-history-panel__overview {
    flex-direction: column;
    min-height: 0;
    padding: 28px 30px;
}

.quiz-history-panel--compact .quiz-history-panel__overview-copy {
    width: 100%;
    margin-right: 0;
    margin-bottom: 22px;
}

.quiz-history-panel--compact .quiz-history-panel__overview-title {
    font-size: 36px;
}

.quiz-history-panel--compact .quiz-history-panel__overview-metrics {
    width: 100%;
}

.quiz-history-panel--compact .quiz-history-panel__filter-card {
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
}

.quiz-history-panel--compact .quiz-history-panel__filter-copy {
    margin-right: 0;
    margin-bottom: 18px;
}

.quiz-history-panel--compact .quiz-history-panel__filter-controls {
    justify-content: flex-start;
}

.quiz-history-panel--compact .quiz-history-panel__filter-dropdown {
    margin-left: 0;
    margin-right: 12px;
}

.quiz-history-panel--compact .quiz-history-panel__reset-filters {
    margin-left: 0;
}

.quiz-history-panel--compact .quiz-history-panel__result-card {
    flex-wrap: wrap;
    min-height: 0;
}

.quiz-history-panel--compact .quiz-history-panel__result-identity {
    width: 100%;
    margin-right: 0;
    margin-bottom: 18px;
}

.quiz-history-panel--compact .quiz-history-panel__result-score {
    width: 45%;
    margin-right: 16px;
    align-items: flex-start;
}

.quiz-history-panel--compact .quiz-history-panel__result-action {
    width: 45%;
    min-width: 0;
    justify-content: center;
}

.quiz-history-panel--compact .quiz-history-panel__result-counts {
    -unity-text-align: middle-left;
}

/* ========== NARROW < 820 ========== */
.quiz-history-panel--narrow .quiz-history-panel__body {
    padding: 22px 20px 32px 20px;
}

.quiz-history-panel--narrow .quiz-history-panel__overview,
.quiz-history-panel--narrow .quiz-history-panel__filter-card,
.quiz-history-panel--narrow .quiz-history-panel__result-card,
.quiz-history-panel--narrow .quiz-history-panel__filter-empty,
.quiz-history-panel--narrow .quiz-history-panel__offline-notice,
.quiz-history-panel--narrow .quiz-history-panel__overview-metrics,
.quiz-history-panel--narrow .quiz-history-panel__metric-card,
.quiz-history-panel--narrow .quiz-history-panel__filter-controls,
.quiz-history-panel--narrow .quiz-history-panel__filter-dropdown,
.quiz-history-panel--narrow .quiz-history-panel__reset-filters,
.quiz-history-panel--narrow .quiz-history-panel__back-button,
.quiz-history-panel--narrow .quiz-history-panel__view-result-button,
.quiz-history-panel--narrow .quiz-history-panel__filter-empty-reset {
    margin-left: 0;
    margin-right: 0;
}

.quiz-history-panel--narrow .quiz-history-panel__overview-title {
    font-size: 30px;
}

.quiz-history-panel--narrow .quiz-history-panel__overview-description {
    font-size: 20px;
}

.quiz-history-panel--narrow .quiz-history-panel__overview-metrics {
    flex-wrap: wrap;
}

.quiz-history-panel--narrow .quiz-history-panel__metric-card {
    flex-basis: 48%;
    min-width: 140px;
    margin-right: 0;
    margin-bottom: 12px;
}

.quiz-history-panel--narrow .quiz-history-panel__back-button {
    width: 100%;
    align-self: stretch;
}

.quiz-history-panel--narrow .quiz-history-panel__filter-dropdown {
    width: 100%;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 12px;
}

.quiz-history-panel--narrow .quiz-history-panel__reset-filters {
    width: 100%;
}

.quiz-history-panel--narrow .quiz-history-panel__result-card {
    flex-direction: column;
    padding: 24px;
}

.quiz-history-panel--narrow .quiz-history-panel__result-identity,
.quiz-history-panel--narrow .quiz-history-panel__result-score,
.quiz-history-panel--narrow .quiz-history-panel__result-action {
    width: 100%;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 18px;
}

.quiz-history-panel--narrow .quiz-history-panel__result-action {
    margin-bottom: 0;
}

.quiz-history-panel--narrow .quiz-history-panel__result-title {
    font-size: 28px;
}

.quiz-history-panel--narrow .quiz-history-panel__result-percentage {
    font-size: 44px;
}

.quiz-history-panel--narrow .quiz-history-panel__view-result-button {
    width: 100%;
}

.quiz-history-panel--narrow .quiz-history-panel__filter-empty-reset {
    width: 100%;
}
