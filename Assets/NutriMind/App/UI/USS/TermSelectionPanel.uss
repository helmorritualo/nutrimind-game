/* Term Selection — 1920×1080 landscape, matched to TermSelectionScreen design reference */

.term-selection {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.term-selection Label {
    margin: 0;
    padding: 0;
}

/* ========== ROUTE INTRO ========== */
.term-selection__intro {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
    padding: 20px 36px 14px 36px;
}

.term-selection__back {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    padding: 0;
    margin: 0 20px 0 0;
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 16px;
    background-color: var(--color-surface);
    align-items: center;
    justify-content: center;
}

.term-selection__back:hover {
    background-color: var(--color-surface-hover);
}

.term-selection__back > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.term-selection__back-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.term-selection__count {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: center;
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    margin-left: 20px;
    padding: 0 18px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 22px;
}

.term-selection__count-icon {
    width: 22px;
    height: 22px;
    min-width: 22px;
    min-height: 22px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-primary);
}

.term-selection__count-label {
    font-size: 17px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.term-selection Label.term-selection__count-label {
    margin: 0;
    padding: 0;
}

/* ========== SUBJECT IDENTITY ========== */
.term-selection__subject {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding: 0;
}

.term-selection__subject-hex {
    width: 72px;
    height: 66px;
    min-width: 72px;
    min-height: 66px;
    margin-right: 18px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--nm-science);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-bottom-right-radius: 18px;
    border-left-width: 8px;
    border-right-width: 8px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-color: rgba(255, 255, 255, 0.18);
}

.term-selection__subject-hex--literaquest {
    background-color: var(--nm-literaquest);
}

.term-selection__subject-hex--pe-health {
    background-color: var(--nm-pe-health);
}

.term-selection__subject-hex--science {
    background-color: var(--nm-science);
}

.term-selection__subject-hex-icon {
    width: 42px;
    height: 42px;
    -unity-background-image-tint-color: #FFFFFF;
}

.term-selection__subject-text {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.term-selection__subject-title {
    font-size: 28px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    letter-spacing: -0.4px;
    white-space: nowrap;
    margin-bottom: 4px;
}

.term-selection Label.term-selection__subject-title {
    margin: 0 0 6px 0;
    padding: 0;
}

.term-selection__subject-subtitle {
    font-size: 16px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    white-space: normal;
}

.term-selection Label.term-selection__subject-subtitle {
    margin: 0;
    padding: 0;
}

/* ========== CONTENT / SCROLL ========== */
.term-selection__content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 20px 56px 28px 56px;
}

.term-selection__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    height: 100%;
}

.term-selection__scroll > .unity-scroll-view__content-and-vertical-scroll-container,
.term-selection__scroll > .unity-scroll-view__content-and-horizontal-scroll-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: 100%;
}

.term-selection__scroll .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    height: 100%;
}

.term-selection__scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    /* Fill the scaled panel height from PS_AppPanels (1920×1080 reference). */
    height: 100%;
    min-height: 0;
    padding: 8px 4px 12px 4px;
}

.term-selection__cards {
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
}

/* ========== TERM CARDS ==========
   Stable two-block template for every term state:
   - card-main: icon + copy (top)
   - card-bottom: status pill + footer (never overlaps main)
   space-between keeps them apart when the card is tall; neither block shrinks.
*/
.term-selection__card {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    min-width: 280px;
    max-width: 480px;
    height: 100%;
    min-height: 0;
    /* UITK has no gap/:last-child — space cards via symmetric horizontal margins */
    margin-left: 14px;
    margin-right: 14px;
    padding: 0;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 28px;
    overflow: hidden;
}

.term-selection__card:hover {
    border-color: var(--color-border-strong);
}

.term-selection__card:focus {
    border-color: var(--nm-science);
}

.term-selection__card.is-selected {
    border-width: 3px;
    border-color: var(--nm-science);
}

.term-selection__card--locked:hover,
.term-selection__card--locked:focus {
    border-color: var(--color-border);
}

/* Available state — unlocked term not yet started. Not used by the current
   3-term static data set (Term 1 completed / Term 2 in progress / Term 3
   locked), but supported here for future data-driven term counts. */
.term-selection__card--available:hover {
    border-color: var(--color-border-strong);
}

.term-selection__status-icon--available {
    background-color: rgba(0, 0, 0, 0);
    border-width: 4px;
    border-color: #9CA3AF;
}

.term-selection__status-pill--available {
    background-color: #EEF0F3;
}

.term-selection__status-pill--available .term-selection__status-pill-label {
    color: #6B7280;
}

.term-selection__card > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.term-selection__card-tab {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 56px;
    min-height: 56px;
    width: 100%;
    padding: 0 20px;
}

.term-selection__card-tab--active {
    background-color: var(--nm-science);
}

.term-selection__card-tab--locked {
    background-color: #6B7280;
}

.term-selection__card-tab-label {
    font-size: 22px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.term-selection Label.term-selection__card-tab-label {
    margin: 0;
    padding: 0;
}

.term-selection__card-body {
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    padding: 28px 28px 24px 28px;
}

/* Top block: icon + title/description */
.term-selection__card-main {
    flex-direction: column;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

/* Bottom block: status pill + missions footer — never shares space with main */
.term-selection__card-bottom {
    flex-direction: column;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    margin-top: 24px;
}

.term-selection__card-footer {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

/* Status icons — fixed footprint */
.term-selection__status-icon {
    width: 112px;
    height: 112px;
    min-width: 112px;
    min-height: 112px;
    max-width: 112px;
    max-height: 112px;
    margin-bottom: 24px;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    border-radius: 56px;
}

.term-selection__status-icon--completed {
    background-color: var(--nm-science);
}

.term-selection__status-icon--progress {
    background-color: rgba(0, 0, 0, 0);
    position: relative;
}

.term-selection__status-icon--locked {
    background-color: #9CA3AF;
}

.term-selection__status-glyph {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #FFFFFF;
}

.term-selection__status-glyph--locked {
    width: 44px;
    height: 44px;
}

/* Circular progress stand-in (~72%) using border-color quadrants */
.term-selection__ring-track {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 56px;
    border-width: 12px;
    border-color: #E5E7EB;
    background-color: rgba(0, 0, 0, 0);
}

.term-selection__ring-fill {
    position: absolute;
    left: -12px;
    top: -12px;
    right: -12px;
    bottom: -12px;
    border-radius: 56px;
    border-width: 12px;
    border-top-color: var(--nm-science);
    border-right-color: var(--nm-science);
    border-bottom-color: var(--nm-science);
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.term-selection__ring-pct {
    font-size: 26px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.term-selection Label.term-selection__ring-pct {
    margin: 0;
    padding: 0;
}

/* Copy block — reserved heights keep cards aligned with dynamic text */
.term-selection__card-copy {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

.term-selection__card-title {
    width: 100%;
    min-height: 64px;
    max-height: 64px;
    font-size: 26px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: -0.3px;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.term-selection Label.term-selection__card-title {
    margin: 0 0 10px 0;
    padding: 0;
}

.term-selection__card-desc {
    width: 100%;
    min-height: 54px;
    max-height: 54px;
    font-size: 16px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.term-selection Label.term-selection__card-desc {
    margin: 0;
    padding: 0;
}

/* Status pills — fixed slot above the footer, never overlapping missions */
.term-selection__status-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: center;
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    padding: 0 28px;
    border-radius: 24px;
    margin-top: 0;
    margin-bottom: 20px;
    flex-grow: 0;
    flex-shrink: 0;
}

.term-selection__status-pill--completed {
    background-color: rgba(76, 175, 80, 0.16);
}

.term-selection__status-pill--progress {
    background-color: rgba(59, 130, 246, 0.16);
}

.term-selection__status-pill--locked {
    background-color: #EEF0F3;
}

.term-selection__status-pill-label {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.term-selection__status-pill--completed .term-selection__status-pill-label {
    color: #2E7D32;
}

.term-selection__status-pill--progress .term-selection__status-pill-label {
    color: #1D4ED8;
}

.term-selection__status-pill--locked .term-selection__status-pill-label {
    color: #6B7280;
}

.term-selection Label.term-selection__status-pill-label {
    margin: 0;
    padding: 0;
}

.term-selection__divider {
    width: 100%;
    height: 1px;
    min-height: 1px;
    background-color: var(--color-border);
    margin-bottom: 18px;
    flex-shrink: 0;
}

.term-selection__stats {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    flex-shrink: 0;
}

.term-selection__stat {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.term-selection__stat-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    flex-shrink: 0;
}

.term-selection__stat-icon--tasks {
    -unity-background-image-tint-color: #6B7280;
}

.term-selection__stat-icon--muted {
    -unity-background-image-tint-color: #B0B5BD;
}

.term-selection__stat-label {
    font-size: 18px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.term-selection__stat-label--muted {
    color: #9CA3AF;
}

.term-selection Label.term-selection__stat-label {
    margin: 0;
    padding: 0;
}

/* Areas summary — always reserved so in-progress footers match other states */
.term-selection__areas-summary {
    width: 100%;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.term-selection__areas-summary--empty {
    color: rgba(0, 0, 0, 0);
}

.term-selection Label.term-selection__areas-summary {
    margin: 12px 0 0 0;
    padding: 0;
}

/* ========== RESPONSIVE ========== */
.term-selection--compact .term-selection__intro {
    padding: 16px 24px 10px 24px;
}

.term-selection--compact .term-selection__subject {
    padding: 0;
}

.term-selection--compact .term-selection__subject-hex {
    width: 64px;
    height: 58px;
    min-width: 64px;
    min-height: 58px;
    margin-right: 14px;
}

.term-selection--compact .term-selection__subject-hex-icon {
    width: 30px;
    height: 30px;
}

.term-selection--compact .term-selection__subject-title {
    font-size: 24px;
}

.term-selection--compact .term-selection__subject-subtitle {
    font-size: 14px;
}

.term-selection--compact .term-selection__content {
    padding: 12px 24px 18px 24px;
}

.term-selection--compact .term-selection__card {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 10px;
    margin-right: 10px;
    flex-basis: auto;
    width: 340px;
    min-width: 340px;
    max-width: 340px;
    margin-right: 0;
    border-radius: 24px;
}

.term-selection--compact .term-selection__card-tab {
    height: 48px;
    min-height: 48px;
}

.term-selection--compact .term-selection__card-tab-label {
    font-size: 18px;
}

.term-selection--compact .term-selection__card-body {
    padding: 24px 22px 20px 22px;
}

.term-selection--compact .term-selection__status-icon {
    width: 96px;
    height: 96px;
    min-width: 96px;
    min-height: 96px;
    max-width: 96px;
    max-height: 96px;
    margin-bottom: 18px;
    border-radius: 48px;
}

.term-selection--compact .term-selection__ring-track,
.term-selection--compact .term-selection__ring-fill {
    border-radius: 48px;
}

.term-selection--compact .term-selection__status-glyph {
    width: 44px;
    height: 44px;
}

.term-selection--compact .term-selection__ring-pct {
    font-size: 22px;
}

.term-selection--compact .term-selection__card-title {
    min-height: 52px;
    max-height: 52px;
    font-size: 22px;
}

.term-selection--compact .term-selection__card-desc {
    min-height: 44px;
    max-height: 44px;
    font-size: 14px;
}

.term-selection--compact .term-selection__status-pill {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    padding: 0 22px;
}

.term-selection--compact .term-selection__status-pill-label {
    font-size: 16px;
}

.term-selection--narrow .term-selection__intro {
    flex-wrap: wrap;
    padding: 14px 18px 8px 18px;
}

.term-selection--narrow .term-selection__back {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    margin-right: 12px;
    border-radius: 12px;
}

.term-selection--narrow .term-selection__subject-title {
    font-size: 20px;
    white-space: normal;
}

.term-selection--narrow .term-selection__subject-subtitle {
    font-size: 13px;
}

.term-selection--narrow .term-selection__subject-hex {
    width: 52px;
    height: 48px;
    min-width: 52px;
    min-height: 48px;
    margin-right: 12px;
}

.term-selection--narrow .term-selection__subject-hex-icon {
    width: 24px;
    height: 24px;
}

.term-selection--narrow .term-selection__count {
    height: 40px;
    min-height: 40px;
    max-height: 40px;
    margin-left: 0;
    margin-top: 8px;
    padding: 0 14px;
    align-self: flex-start;
}

.term-selection--narrow .term-selection__count-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    margin-right: 8px;
}

.term-selection--narrow .term-selection__count-label {
    font-size: 15px;
}

.term-selection--narrow .term-selection__card {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    flex-basis: auto;
    width: 300px;
    min-width: 300px;
    max-width: 300px;
    margin-right: 0;
}

.term-selection--narrow .term-selection__card-body {
    padding: 20px 18px 16px 18px;
}

.term-selection--narrow .term-selection__status-icon {
    width: 84px;
    height: 84px;
    min-width: 84px;
    min-height: 84px;
    max-width: 84px;
    max-height: 84px;
    margin-bottom: 14px;
    border-radius: 42px;
}

.term-selection--narrow .term-selection__ring-track,
.term-selection--narrow .term-selection__ring-fill {
    border-radius: 42px;
    border-width: 10px;
}

.term-selection--narrow .term-selection__ring-fill {
    left: -10px;
    top: -10px;
    right: -10px;
    bottom: -10px;
}

.term-selection--narrow .term-selection__card-title {
    min-height: 48px;
    max-height: 48px;
    font-size: 20px;
}

.term-selection--narrow .term-selection__card-desc {
    min-height: 40px;
    max-height: 40px;
    font-size: 13px;
}

.term-selection--narrow .term-selection__status-pill {
    height: 38px;
    min-height: 38px;
    max-height: 38px;
    padding: 0 18px;
}

.term-selection--narrow .term-selection__status-pill-label {
    font-size: 14px;
}

.term-selection--narrow .term-selection__stat-label {
    font-size: 15px;
}
