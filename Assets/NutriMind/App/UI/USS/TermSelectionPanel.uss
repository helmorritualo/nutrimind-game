/* Term Selection — 1920×1080 landscape, matched to TermSelectionScreen design reference */

.term-selection {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.term-selection Label {
    margin: 0;
    padding: 0;
}

/* ========== HEADER ========== */
.term-selection__header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    height: 100px;
    min-height: 100px;
    padding: 0 40px;
    background-color: var(--color-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.term-selection__header-left {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.term-selection__back {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    padding: 0;
    margin: 0 20px 0 0;
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 16px;
    background-color: var(--color-surface);
    align-items: center;
    justify-content: center;
}

.term-selection__back:hover {
    background-color: var(--color-surface-hover);
}

.term-selection__back > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.term-selection__back-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.term-selection__brand {
    flex-direction: row;
    align-items: flex-end;
    flex-shrink: 0;
}

.term-selection__brand-nutri {
    margin: 0;
    padding: 0;
    font-size: 40px;
    color: var(--nm-brand-green);
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.term-selection__brand-mind-wrap {
    position: relative;
    flex-direction: row;
    align-items: flex-end;
}

.term-selection__brand-mind {
    margin: 0;
    padding: 0;
    font-size: 40px;
    color: var(--nm-brand-blue);
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.term-selection__brand-leaf {
    position: absolute;
    right: -4px;
    top: -6px;
    width: 18px;
    height: 18px;
    -unity-background-image-tint-color: var(--nm-brand-green);
}

/* ========== SUBJECT INTRO ========== */
.term-selection__subject {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 28px 56px 8px 56px;
}

.term-selection__subject-hex {
    width: 88px;
    height: 80px;
    min-width: 88px;
    min-height: 80px;
    margin-right: 22px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: var(--nm-science);
    border-top-left-radius: 22px;
    border-top-right-radius: 22px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
    border-left-width: 8px;
    border-right-width: 8px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-color: rgba(255, 255, 255, 0.18);
}

.term-selection__subject-hex-icon {
    width: 42px;
    height: 42px;
    -unity-background-image-tint-color: #FFFFFF;
}

.term-selection__subject-text {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.term-selection__subject-title {
    font-size: 42px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    letter-spacing: -0.5px;
    white-space: nowrap;
    margin-bottom: 6px;
}

.term-selection Label.term-selection__subject-title {
    margin: 0 0 6px 0;
    padding: 0;
}

.term-selection__subject-subtitle {
    font-size: 20px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    white-space: normal;
}

.term-selection Label.term-selection__subject-subtitle {
    margin: 0;
    padding: 0;
}

/* ========== CONTENT / SCROLL ========== */
.term-selection__content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 20px 56px 28px 56px;
}

.term-selection__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
}

.term-selection__scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    padding: 8px 4px 12px 4px;
}

.term-selection__cards {
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
    /* UITK has no :last-child — use gap instead of trailing card margins */
    column-gap: 28px;
}

/* ========== TERM CARDS ==========
   Stable template for dynamic text:
   - Fixed icon zone
   - Reserved title (2 lines) + description (3 lines)
   - Status pill stays in place
   - Footer pinned to bottom
*/
.term-selection__card {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    min-width: 280px;
    max-width: 480px;
    height: 100%;
    min-height: 0;
    margin-right: 0;
    padding: 0;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 28px;
    overflow: hidden;
}

.term-selection__card:hover {
    border-color: var(--color-border-strong);
}

.term-selection__card > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.term-selection__card-tab {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    height: 56px;
    min-height: 56px;
    width: 100%;
    padding: 0 20px;
}

.term-selection__card-tab--active {
    background-color: var(--nm-science);
}

.term-selection__card-tab--locked {
    background-color: #6B7280;
}

.term-selection__card-tab-label {
    font-size: 22px;
    color: #FFFFFF;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 0.3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.term-selection Label.term-selection__card-tab-label {
    margin: 0;
    padding: 0;
}

.term-selection__card-body {
    flex-direction: column;
    align-items: stretch;
    justify-content: space-between;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    padding: 32px 28px 24px 28px;
}

.term-selection__card-top {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
}

.term-selection__card-footer {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    margin-top: 24px;
}

/* Status icons — fixed footprint */
.term-selection__status-icon {
    width: 112px;
    height: 112px;
    min-width: 112px;
    min-height: 112px;
    max-width: 112px;
    max-height: 112px;
    margin-bottom: 24px;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    border-radius: 56px;
}

.term-selection__status-icon--completed {
    background-color: var(--nm-science);
}

.term-selection__status-icon--progress {
    background-color: rgba(0, 0, 0, 0);
    position: relative;
}

.term-selection__status-icon--locked {
    background-color: #9CA3AF;
}

.term-selection__status-glyph {
    width: 52px;
    height: 52px;
    -unity-background-image-tint-color: #FFFFFF;
}

.term-selection__status-glyph--locked {
    width: 44px;
    height: 44px;
}

/* Circular progress stand-in (~72%) using border-color quadrants */
.term-selection__ring-track {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 56px;
    border-width: 12px;
    border-color: #E5E7EB;
    background-color: rgba(0, 0, 0, 0);
}

.term-selection__ring-fill {
    position: absolute;
    left: -12px;
    top: -12px;
    right: -12px;
    bottom: -12px;
    border-radius: 56px;
    border-width: 12px;
    border-top-color: var(--nm-science);
    border-right-color: var(--nm-science);
    border-bottom-color: var(--nm-science);
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
}

.term-selection__ring-pct {
    font-size: 26px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.term-selection Label.term-selection__ring-pct {
    margin: 0;
    padding: 0;
}

/* Copy block — reserved heights keep cards aligned with dynamic text */
.term-selection__card-copy {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    margin-bottom: 20px;
}

.term-selection__card-title {
    width: 100%;
    min-height: 72px;
    max-height: 72px;
    font-size: 26px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    letter-spacing: -0.3px;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.term-selection Label.term-selection__card-title {
    margin: 0 0 10px 0;
    padding: 0;
}

.term-selection__card-desc {
    width: 100%;
    min-height: 66px;
    max-height: 66px;
    font-size: 16px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    text-overflow: ellipsis;
}

.term-selection Label.term-selection__card-desc {
    margin: 0;
    padding: 0;
}

/* Status pills */
.term-selection__status-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    padding: 0 28px;
    border-radius: 24px;
    margin-top: auto;
    flex-grow: 0;
    flex-shrink: 0;
}

.term-selection__status-pill--completed {
    background-color: rgba(76, 175, 80, 0.16);
}

.term-selection__status-pill--progress {
    background-color: rgba(59, 130, 246, 0.16);
}

.term-selection__status-pill--locked {
    background-color: #EEF0F3;
}

.term-selection__status-pill-label {
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.term-selection__status-pill--completed .term-selection__status-pill-label {
    color: #2E7D32;
}

.term-selection__status-pill--progress .term-selection__status-pill-label {
    color: #1D4ED8;
}

.term-selection__status-pill--locked .term-selection__status-pill-label {
    color: #6B7280;
}

.term-selection Label.term-selection__status-pill-label {
    margin: 0;
    padding: 0;
}

.term-selection__divider {
    width: 100%;
    height: 1px;
    min-height: 1px;
    background-color: var(--color-border);
    margin-bottom: 18px;
    flex-shrink: 0;
}

.term-selection__stats {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex-shrink: 0;
}

.term-selection__stat {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    min-width: 0;
}

.term-selection__stat-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    flex-shrink: 0;
}

.term-selection__stat-icon--tasks {
    -unity-background-image-tint-color: #6B7280;
}

.term-selection__stat-icon--muted {
    -unity-background-image-tint-color: #B0B5BD;
}

.term-selection__stat-label {
    font-size: 18px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.term-selection__stat-label--muted {
    color: #9CA3AF;
}

.term-selection Label.term-selection__stat-label {
    margin: 0;
    padding: 0;
}

/* ========== BOTTOM NAV ========== */
.term-selection__nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    flex-shrink: 0;
    height: 104px;
    min-height: 104px;
    padding: 10px 40px 14px 40px;
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.term-selection__nav-item {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-basis: 0;
    height: 80px;
    margin: 0 6px;
    padding: 10px 8px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 18px;
}

.term-selection__nav-item:hover {
    background-color: var(--color-surface-hover);
}

.term-selection__nav-item.is-active .term-selection__nav-icon {
    -unity-background-image-tint-color: var(--color-primary);
}

.term-selection__nav-item.is-active .term-selection__nav-label {
    color: var(--color-primary);
}

.term-selection__nav-icon {
    width: 32px;
    height: 32px;
    margin-bottom: 8px;
    -unity-background-image-tint-color: #757575;
}

.term-selection__nav-label {
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: #5C5C5C;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.term-selection__nav-icon-ph {
    width: 32px;
    height: 32px;
    margin-bottom: 8px;
    border-radius: 8px;
    background-color: #EEEEEE;
    border-width: 1px;
    border-color: #D0D0D0;
    align-items: center;
    justify-content: center;
}

.term-selection__nav-icon-ph-label {
    margin: 0;
    padding: 0;
    font-size: 9px;
    color: #9E9E9E;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ========== RESPONSIVE ========== */
.term-selection--compact .term-selection__header {
    height: auto;
    min-height: 84px;
    padding: 14px 24px;
}

.term-selection--compact .term-selection__brand-nutri,
.term-selection--compact .term-selection__brand-mind {
    font-size: 32px;
}

.term-selection--compact .term-selection__subject {
    padding: 18px 24px 4px 24px;
}

.term-selection--compact .term-selection__subject-hex {
    width: 72px;
    height: 66px;
    min-width: 72px;
    min-height: 66px;
    margin-right: 16px;
}

.term-selection--compact .term-selection__subject-hex-icon {
    width: 34px;
    height: 34px;
}

.term-selection--compact .term-selection__subject-title {
    font-size: 32px;
}

.term-selection--compact .term-selection__subject-subtitle {
    font-size: 16px;
}

.term-selection--compact .term-selection__content {
    padding: 12px 24px 18px 24px;
}

.term-selection--compact .term-selection__cards {
    column-gap: 20px;
}

.term-selection--compact .term-selection__card {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 340px;
    min-width: 340px;
    max-width: 340px;
    margin-right: 0;
    border-radius: 24px;
}

.term-selection--compact .term-selection__card-tab {
    height: 48px;
    min-height: 48px;
}

.term-selection--compact .term-selection__card-tab-label {
    font-size: 18px;
}

.term-selection--compact .term-selection__card-body {
    padding: 24px 22px 20px 22px;
}

.term-selection--compact .term-selection__status-icon {
    width: 96px;
    height: 96px;
    min-width: 96px;
    min-height: 96px;
    max-width: 96px;
    max-height: 96px;
    margin-bottom: 18px;
    border-radius: 48px;
}

.term-selection--compact .term-selection__ring-track,
.term-selection--compact .term-selection__ring-fill {
    border-radius: 48px;
}

.term-selection--compact .term-selection__status-glyph {
    width: 44px;
    height: 44px;
}

.term-selection--compact .term-selection__ring-pct {
    font-size: 22px;
}

.term-selection--compact .term-selection__card-title {
    min-height: 60px;
    max-height: 60px;
    font-size: 22px;
}

.term-selection--compact .term-selection__card-desc {
    min-height: 54px;
    max-height: 54px;
    font-size: 14px;
}

.term-selection--compact .term-selection__status-pill {
    height: 42px;
    min-height: 42px;
    max-height: 42px;
    padding: 0 22px;
}

.term-selection--compact .term-selection__status-pill-label {
    font-size: 16px;
}

.term-selection--compact .term-selection__nav {
    height: auto;
    min-height: 80px;
    padding: 8px 12px 12px 12px;
    flex-wrap: wrap;
}

.term-selection--compact .term-selection__nav-item {
    flex-grow: 0;
    width: 84px;
    height: 72px;
}

.term-selection--narrow .term-selection__brand-nutri,
.term-selection--narrow .term-selection__brand-mind {
    font-size: 28px;
}

.term-selection--narrow .term-selection__back {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    margin-right: 12px;
    border-radius: 12px;
}

.term-selection--narrow .term-selection__subject-title {
    font-size: 26px;
}

.term-selection--narrow .term-selection__subject-subtitle {
    font-size: 14px;
}

.term-selection--narrow .term-selection__subject-hex {
    width: 60px;
    height: 56px;
    min-width: 60px;
    min-height: 56px;
    margin-right: 12px;
}

.term-selection--narrow .term-selection__subject-hex-icon {
    width: 28px;
    height: 28px;
}

.term-selection--narrow .term-selection__cards {
    column-gap: 16px;
}

.term-selection--narrow .term-selection__card {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 300px;
    min-width: 300px;
    max-width: 300px;
    margin-right: 0;
}

.term-selection--narrow .term-selection__card-body {
    padding: 20px 18px 16px 18px;
}

.term-selection--narrow .term-selection__status-icon {
    width: 84px;
    height: 84px;
    min-width: 84px;
    min-height: 84px;
    max-width: 84px;
    max-height: 84px;
    margin-bottom: 14px;
    border-radius: 42px;
}

.term-selection--narrow .term-selection__ring-track,
.term-selection--narrow .term-selection__ring-fill {
    border-radius: 42px;
    border-width: 10px;
}

.term-selection--narrow .term-selection__ring-fill {
    left: -10px;
    top: -10px;
    right: -10px;
    bottom: -10px;
}

.term-selection--narrow .term-selection__card-title {
    min-height: 52px;
    max-height: 52px;
    font-size: 20px;
}

.term-selection--narrow .term-selection__card-desc {
    min-height: 48px;
    max-height: 48px;
    font-size: 13px;
}

.term-selection--narrow .term-selection__status-pill {
    height: 38px;
    min-height: 38px;
    max-height: 38px;
    padding: 0 18px;
}

.term-selection--narrow .term-selection__status-pill-label {
    font-size: 14px;
}

.term-selection--narrow .term-selection__stat-label {
    font-size: 15px;
}

.term-selection--narrow .term-selection__nav-label {
    font-size: 11px;
}
