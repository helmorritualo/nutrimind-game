/* Rewards route — hosted by AppShell or standalone UIDocument preview */

.rewards-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    position: relative;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.rewards-panel.app-screen-content--embedded {
    background-color: rgba(0, 0, 0, 0);
}

.rewards-panel Label {
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-font-style: bold;
}

/* ========== SHELL ========== */
.rewards-panel__content-shell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.rewards-panel__content-shell.rewards-panel__content-shell--hidden {
    display: none;
}

/* ========== SCROLL ========== */
.rewards-panel__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
}

.rewards-panel__scroll > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.rewards-panel__scroll .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.rewards-panel__scroll .unity-scroll-view__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: 100%;
    min-width: 0;
    height: auto;
}

.rewards-panel__body {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    height: auto;
    padding: 30px 36px 44px 36px;
}

/* ========== DATA STATE HOST ========== */
.rewards-panel__data-state-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: none;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.rewards-panel__data-state-host.rewards-panel__data-state-host--visible {
    display: flex;
}

/* ========== OFFLINE NOTICE ========== */
.rewards-panel__offline-notice {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    min-height: 96px;
    margin-bottom: 26px;
    padding: 22px 26px;
    background-color: var(--color-warning-soft);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.rewards-panel__offline-notice.rewards-panel__offline-notice--hidden {
    display: none;
}

.rewards-panel__offline-icon {
    width: 28px;
    height: 28px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.rewards-panel__offline-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.rewards-panel__offline-title {
    font-size: 22px;
    color: var(--color-text-primary);
    margin-bottom: 8px;
}

.rewards-panel__offline-message {
    font-size: 19px;
    color: var(--color-text-secondary);
}

/* ========== OVERVIEW ========== */
.rewards-panel__overview {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
    min-height: 250px;
    margin-bottom: 26px;
    padding: 38px 40px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.rewards-panel__overview-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    width: 48%;
    margin-right: 28px;
}

.rewards-panel__overview-icon {
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--nm-literaquest);
}

.rewards-panel__overview-eyebrow {
    font-size: 21px;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
}

.rewards-panel__overview-title {
    font-size: 46px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: 12px;
    white-space: normal;
}

.rewards-panel__overview-description {
    font-size: 22px;
    color: var(--color-text-secondary);
}

.rewards-panel__overview-metrics {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    width: 52%;
    min-width: 0;
}

.rewards-panel__metric-card {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    min-height: 128px;
    margin-right: 12px;
    padding: 20px 16px;
    background-color: var(--color-bg);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
}

.rewards-panel__metric-card--last {
    margin-right: 0;
}

.rewards-panel__metric-card--owned {
    border-color: rgba(76, 175, 80, 0.35);
}

.rewards-panel__metric-card--available {
    border-color: rgba(139, 92, 246, 0.35);
}

.rewards-panel__metric-card--used {
    border-color: rgba(30, 136, 229, 0.35);
}

.rewards-panel__metric-card--locked {
    border-color: var(--color-border);
}

.rewards-panel__metric-value {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: 8px;
}

.rewards-panel__metric-card--owned .rewards-panel__metric-value {
    color: var(--color-primary);
}

.rewards-panel__metric-card--available .rewards-panel__metric-value {
    color: var(--nm-literaquest);
}

.rewards-panel__metric-card--used .rewards-panel__metric-value {
    color: var(--color-secondary);
}

.rewards-panel__metric-card--locked .rewards-panel__metric-value {
    color: var(--color-text-secondary);
}

.rewards-panel__metric-label {
    font-size: 19px;
    color: var(--color-text-secondary);
}

/* ========== FILTER CARD ========== */
.rewards-panel__filter-card {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
    min-height: 114px;
    margin-bottom: 26px;
    padding: 24px 26px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.rewards-panel__filter-copy {
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 180px;
    max-width: 280px;
    margin-right: 20px;
}

.rewards-panel__filter-title {
    font-size: 24px;
    color: var(--color-text-primary);
    margin-bottom: 6px;
}

.rewards-panel__filter-description {
    font-size: 18px;
    color: var(--color-text-secondary);
}

.rewards-panel__filter-controls {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
}

.rewards-panel__filter-button {
    min-height: 54px;
    margin-left: 8px;
    margin-bottom: 8px;
    padding-left: 18px;
    padding-right: 18px;
    font-size: 19px;
    color: var(--color-text-primary);
}

.rewards-panel__filter-button--selected {
    background-color: var(--color-tertiary-soft);
    color: var(--nm-literaquest);
}

/* ========== RESULTS HEADER ========== */
.rewards-panel__results-header {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
    margin-bottom: 18px;
}

.rewards-panel__results-title {
    font-size: 32px;
    color: var(--color-text-primary);
}

.rewards-panel__visible-count {
    font-size: 19px;
    color: var(--color-text-secondary);
}

/* ========== GRID ========== */
.rewards-panel__grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    width: 100%;
    min-width: 0;
    margin-bottom: 8px;
}

.rewards-panel__card {
    flex-direction: column;
    width: 48.5%;
    min-width: 360px;
    min-height: 290px;
    margin-right: 3%;
    margin-bottom: 24px;
    padding: 30px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.rewards-panel__card--last-in-row {
    margin-right: 0;
}

.rewards-panel__card--owned {
    border-color: rgba(76, 175, 80, 0.4);
}

.rewards-panel__card--available {
    border-color: rgba(139, 92, 246, 0.4);
}

.rewards-panel__card--used {
    border-color: rgba(30, 136, 229, 0.35);
}

.rewards-panel__card--locked {
    border-color: var(--color-border-strong);
}

.rewards-panel__card-header {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 18px;
}

.rewards-panel__card-icon {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.rewards-panel__card--owned .rewards-panel__card-icon {
    -unity-background-image-tint-color: var(--color-primary);
}

.rewards-panel__card--available .rewards-panel__card-icon {
    -unity-background-image-tint-color: var(--nm-literaquest);
}

.rewards-panel__card--used .rewards-panel__card-icon {
    -unity-background-image-tint-color: var(--color-secondary);
}

.rewards-panel__card--locked .rewards-panel__card-icon {
    -unity-background-image-tint-color: var(--color-text-disabled);
}

.rewards-panel__status-chip {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    padding: 8px 14px;
    border-radius: 999px;
    background-color: var(--color-surface-elev);
}

.rewards-panel__status-chip--owned {
    background-color: var(--color-primary-soft);
}

.rewards-panel__status-chip--available {
    background-color: var(--color-tertiary-soft);
}

.rewards-panel__status-chip--used {
    background-color: var(--color-secondary-soft);
}

.rewards-panel__status-chip--locked {
    background-color: var(--color-surface-elev);
}

.rewards-panel__status-chip-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    flex-shrink: 0;
}

.rewards-panel__status-chip--owned .rewards-panel__status-chip-icon {
    -unity-background-image-tint-color: var(--color-primary);
}

.rewards-panel__status-chip--available .rewards-panel__status-chip-icon {
    -unity-background-image-tint-color: var(--nm-literaquest);
}

.rewards-panel__status-chip--used .rewards-panel__status-chip-icon {
    -unity-background-image-tint-color: var(--color-secondary);
}

.rewards-panel__status-chip--locked .rewards-panel__status-chip-icon {
    -unity-background-image-tint-color: var(--color-text-disabled);
}

.rewards-panel__status-chip-label {
    font-size: 18px;
    white-space: nowrap;
}

.rewards-panel__status-chip--owned .rewards-panel__status-chip-label {
    color: var(--color-primary);
}

.rewards-panel__status-chip--available .rewards-panel__status-chip-label {
    color: var(--nm-literaquest);
}

.rewards-panel__status-chip--used .rewards-panel__status-chip-label {
    color: var(--color-secondary);
}

.rewards-panel__status-chip--locked .rewards-panel__status-chip-label {
    color: var(--color-text-secondary);
}

.rewards-panel__card-title {
    font-size: 31px;
    color: var(--color-text-primary);
    margin-bottom: 12px;
}

.rewards-panel__card-description {
    font-size: 20px;
    color: var(--color-text-secondary);
    margin-bottom: 14px;
}

.rewards-panel__card-support {
    font-size: 19px;
    color: var(--color-text-secondary);
    margin-bottom: 10px;
}

.rewards-panel__card-locked-reason {
    font-size: 19px;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
}

.rewards-panel__card-action {
    margin-top: auto;
    align-self: flex-start;
    min-height: 60px;
    padding-left: 22px;
    padding-right: 22px;
    font-size: 21px;
    color: var(--color-text-on-accent);
}

.rewards-panel__card-action:disabled {
    color: var(--color-text-disabled);
}

/* ========== FILTER EMPTY ========== */
.rewards-panel__filter-empty {
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    margin-top: 8px;
    margin-bottom: 12px;
    padding: 28px 30px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.rewards-panel__filter-empty.rewards-panel__filter-empty--hidden {
    display: none;
}

.rewards-panel__filter-empty-icon {
    width: 32px;
    height: 32px;
    margin-bottom: 14px;
    -unity-background-image-tint-color: var(--color-text-secondary);
}

.rewards-panel__filter-empty-title {
    font-size: 26px;
    color: var(--color-text-primary);
    margin-bottom: 10px;
}

.rewards-panel__filter-empty-message {
    font-size: 19px;
    color: var(--color-text-secondary);
    margin-bottom: 18px;
}

.rewards-panel__filter-empty-reset {
    min-height: 54px;
    padding-left: 20px;
    padding-right: 20px;
    font-size: 19px;
    color: var(--color-text-primary);
}

/* ========== COMPACT ========== */
.rewards-panel.rewards-panel--compact .rewards-panel__overview {
    flex-direction: column;
    min-height: 0;
    padding: 32px 30px;
}

.rewards-panel.rewards-panel--compact .rewards-panel__overview-copy {
    width: 100%;
    margin-right: 0;
    margin-bottom: 22px;
}

.rewards-panel.rewards-panel--compact .rewards-panel__overview-metrics {
    width: 100%;
    flex-wrap: wrap;
}

.rewards-panel.rewards-panel--compact .rewards-panel__metric-card {
    width: 48%;
    flex-basis: 48%;
    margin-bottom: 12px;
}

.rewards-panel.rewards-panel--compact .rewards-panel__filter-card {
    flex-direction: column;
    align-items: stretch;
    min-height: 0;
}

.rewards-panel.rewards-panel--compact .rewards-panel__filter-copy {
    max-width: none;
    margin-right: 0;
    margin-bottom: 16px;
}

.rewards-panel.rewards-panel--compact .rewards-panel__filter-controls {
    justify-content: flex-start;
}

.rewards-panel.rewards-panel--compact .rewards-panel__filter-button {
    margin-left: 0;
    margin-right: 8px;
}

.rewards-panel.rewards-panel--compact .rewards-panel__card {
    width: 48.5%;
    min-width: 340px;
}

/* ========== NARROW ========== */
.rewards-panel.rewards-panel--narrow {
    margin: 0;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__body {
    padding: 24px 20px 36px 20px;
    margin: 0;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__overview-title {
    font-size: 34px;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__overview-description {
    font-size: 20px;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__overview-metrics {
    flex-direction: column;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__metric-card {
    width: 100%;
    flex-basis: auto;
    margin-right: 0;
    margin-bottom: 10px;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__metric-card--last {
    margin-bottom: 0;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__filter-button {
    width: 48%;
    margin-right: 2%;
    margin-left: 0;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__results-title {
    font-size: 28px;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__card {
    width: 100%;
    min-width: 0;
    margin-right: 0;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__card-title {
    font-size: 28px;
}

.rewards-panel.rewards-panel--narrow .rewards-panel__card-action {
    align-self: stretch;
    width: 100%;
}
