/* Subject Selection content route hosted by AppShell, with standalone preview support. */

.subject-selection {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.subject-selection.app-screen-content--embedded {
    background-color: rgba(0, 0, 0, 0);
}

.subject-selection Label {
    margin: 0;
    padding: 0;
}

/* ========== ROUTE INTRO ========== */
.subject-selection__intro {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-width: 0;
    padding: 20px 36px 14px 36px;
}

.subject-selection__back {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    padding: 0;
    margin: 0 20px 0 0;
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 26px;
    background-color: var(--color-surface);
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.subject-selection__back:hover {
    background-color: var(--color-surface-hover);
}

.subject-selection__back > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.subject-selection__back-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--color-text-primary);
}

.subject-selection__intro-copy {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.subject-selection__intro-title {
    font-size: 26px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    letter-spacing: -0.4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
}

.subject-selection Label.subject-selection__intro-title {
    margin: 0 0 4px 0;
    padding: 0;
}

.subject-selection__intro-message {
    font-size: 16px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
}

.subject-selection__count {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 20px;
    padding: 10px 18px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 22px;
}

.subject-selection__count-icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-primary);
}

.subject-selection__count-label {
    font-size: 17px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
}

/* ========== CONTENT / SCROLL ========== */
.subject-selection__content {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    padding: 12px 36px 28px 36px;
}

.subject-selection__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    width: 100%;
}

.subject-selection__scroll .unity-scroll-view__content-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    padding: 8px 4px 12px 4px;
}

.subject-selection__cards {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-height: 0;
}

/* ========== SUBJECT CARDS ========== */
.subject-selection__card {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: auto;
    min-width: 0;
    max-width: none;
    height: 100%;
    min-height: 0;
    /* UITK has no gap/:last-child — space cards via symmetric horizontal margins */
    margin-left: 14px;
    margin-right: 14px;
    padding: 34px 36px 32px 36px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 28px;
    overflow: hidden;
    transition-property: border-color;
    transition-duration: 0.15s;
}

/* ----- Card states: available (default), selected, hover, focused, unavailable ----- */
.subject-selection__card:hover {
    border-color: var(--color-border-strong);
}

.subject-selection__card:focus {
    border-color: var(--color-secondary);
}

.subject-selection__card.is-selected {
    border-width: 3px;
    border-color: var(--color-primary);
}

.subject-selection__card--unavailable {
    opacity: 0.72;
}

.subject-selection__card--unavailable:hover {
    border-color: var(--color-border);
}

/* Vertically centers the full content block inside tall cards */
.subject-selection__card-stack {
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    max-width: 480px;
    align-self: center;
}

/* Hexagon stand-in badge — replace with ILL_SubjectHex art when ready */
.subject-selection__hex {
    position: relative;
    width: 128px;
    height: 118px;
    min-width: 128px;
    min-height: 118px;
    margin-bottom: 22px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    border-left-width: 10px;
    border-right-width: 10px;
    border-top-width: 0;
    border-bottom-width: 0;
    border-color: rgba(255, 255, 255, 0.15);
}

/* Lock badge overlay for the unavailable-card demo */
.subject-selection__hex-lock-badge {
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    padding: 9px;
    background-color: #6B7280;
    border-radius: 20px;
    border-width: 3px;
    border-color: var(--color-surface);
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.subject-selection__hex--lq {
    background-color: var(--nm-literaquest);
}

.subject-selection__hex--peh {
    background-color: var(--nm-pe-health);
}

.subject-selection__hex--sci {
    background-color: var(--nm-science);
}

.subject-selection__hex-icon {
    width: 60px;
    height: 60px;
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.subject-selection__card-title {
    font-size: 34px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: -0.5px;
    white-space: nowrap;
    margin-bottom: 10px;
}

.subject-selection Label.subject-selection__card-title {
    margin: 0 0 10px 0;
    padding: 0;
}

.subject-selection__card-desc {
    font-size: 18px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 380px;
    margin-bottom: 26px;
    flex-shrink: 0;
}

.subject-selection Label.subject-selection__card-desc {
    margin: 0 0 26px 0;
    padding: 0;
}

.subject-selection__progress-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-bottom: 18px;
    flex-shrink: 0;
}

.subject-selection__progress-track {
    flex-grow: 1;
    flex-shrink: 1;
    height: 14px;
    border-radius: 7px;
    background-color: var(--color-border);
    margin-right: 14px;
    overflow: hidden;
}

.subject-selection__progress-fill {
    height: 100%;
    border-radius: 7px;
}

.subject-selection__progress-fill--lq {
    width: 60%;
    background-color: var(--nm-literaquest);
}

.subject-selection__progress-fill--peh {
    width: 67%;
    background-color: var(--nm-pe-health);
}

.subject-selection__progress-fill--sci {
    width: 73%;
    background-color: var(--nm-science);
}

.subject-selection__progress-pct {
    font-size: 20px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 52px;
    -unity-text-align: middle-right;
}

.subject-selection Label.subject-selection__progress-pct {
    margin: 0;
    padding: 0;
}

.subject-selection__stats {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    margin-bottom: 28px;
    flex-shrink: 0;
}

.subject-selection__stat {
    flex-direction: row;
    align-items: center;
    margin-right: 28px;
}

.subject-selection__stat-icon {
    width: 28px;
    height: 28px;
    margin-right: 10px;
    flex-shrink: 0;
}

.subject-selection__stat-icon--tasks {
    -unity-background-image-tint-color: var(--color-text-disabled);
}

.subject-selection__stat-label {
    font-size: 20px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: nowrap;
}

.subject-selection Label.subject-selection__stat-label {
    margin: 0;
    padding: 0;
}

.subject-selection__unavailable-note {
    width: 100%;
    font-size: 15px;
    color: var(--color-text-disabled);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 18px;
}

.subject-selection Label.subject-selection__unavailable-note {
    margin: 0 0 18px 0;
    padding: 0;
}

/* ========== CTA BUTTONS ========== */
.subject-selection__cta {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    align-self: stretch;
    width: 100%;
    height: 62px;
    min-height: 62px;
    max-height: 62px;
    margin-top: 0;
    padding: 0 26px 0 30px;
    border-width: 0;
    border-radius: 20px;
    flex-shrink: 0;
    background-color: var(--color-primary);
}

.subject-selection__cta:hover {
    background-color: var(--color-primary-hover);
}

.subject-selection__cta:active {
    background-color: var(--color-primary-press);
}

/* Unavailable CTA — classroom/server preview only, not a level lock */
.subject-selection__cta--unavailable {
    background-color: #9CA3AF;
}

.subject-selection__cta--unavailable:hover {
    background-color: #9CA3AF;
}

.subject-selection__cta--unavailable:active {
    background-color: #9CA3AF;
}

.subject-selection__cta > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.subject-selection__cta-label {
    font-size: 22px;
    color: var(--color-text-on-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    letter-spacing: 0.2px;
}

.subject-selection Label.subject-selection__cta-label {
    margin: 0;
    padding: 0;
}

.subject-selection__cta-chevron {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

/* ========== RESPONSIVE ========== */
.subject-selection--compact .subject-selection__intro {
    padding: 16px 24px 10px 24px;
}

.subject-selection--compact .subject-selection__intro-title {
    font-size: 22px;
}

.subject-selection--compact .subject-selection__intro-message {
    font-size: 14px;
}

.subject-selection--compact .subject-selection__count {
    padding: 8px 14px;
    margin-left: 14px;
}

.subject-selection--compact .subject-selection__count-label {
    font-size: 15px;
}

.subject-selection--compact .subject-selection__content {
    padding: 10px 24px 20px 24px;
}

.subject-selection--compact .subject-selection__card {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 11px;
    margin-right: 11px;
    flex-basis: auto;
    width: 360px;
    min-width: 360px;
    max-width: 360px;
    padding: 32px 30px 28px 30px;
    border-radius: 24px;
}

.subject-selection--compact .subject-selection__card-stack {
    max-width: 100%;
}

.subject-selection--compact .subject-selection__hex {
    width: 108px;
    height: 100px;
    min-width: 108px;
    min-height: 100px;
    margin-bottom: 20px;
}

.subject-selection--compact .subject-selection__hex-icon {
    width: 50px;
    height: 50px;
}

.subject-selection--compact .subject-selection__card-title {
    font-size: 28px;
}

.subject-selection--compact Label.subject-selection__card-title {
    margin-bottom: 8px;
}

.subject-selection--compact .subject-selection__card-desc {
    font-size: 16px;
    max-width: 300px;
}

.subject-selection--compact Label.subject-selection__card-desc {
    margin-bottom: 22px;
}

.subject-selection--compact .subject-selection__stats {
    margin-bottom: 24px;
}

.subject-selection--compact .subject-selection__cta {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    padding: 0 20px 0 24px;
    border-radius: 18px;
}

.subject-selection--compact .subject-selection__cta-label {
    font-size: 18px;
}

.subject-selection--narrow .subject-selection__intro {
    flex-wrap: wrap;
    padding: 14px 18px 8px 18px;
}

.subject-selection--narrow .subject-selection__back {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    margin-right: 12px;
}

.subject-selection--narrow .subject-selection__intro-title {
    font-size: 19px;
    white-space: normal;
}

.subject-selection--narrow .subject-selection__intro-message {
    font-size: 13px;
    white-space: normal;
}

.subject-selection--narrow .subject-selection__count {
    margin-left: 56px;
    margin-top: 8px;
    padding: 6px 12px;
    align-self: flex-start;
}

.subject-selection--narrow .subject-selection__count-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
}

.subject-selection--narrow .subject-selection__count-label {
    font-size: 13px;
}

.subject-selection--narrow .subject-selection__content {
    padding: 8px 18px 16px 18px;
}

.subject-selection--narrow .subject-selection__card {
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 8px;
    margin-right: 8px;
    flex-basis: auto;
    width: 300px;
    min-width: 300px;
    max-width: 300px;
    padding: 26px 22px 22px 22px;
}

.subject-selection--narrow .subject-selection__hex {
    width: 92px;
    height: 84px;
    min-width: 92px;
    min-height: 84px;
    margin-bottom: 16px;
}

.subject-selection--narrow .subject-selection__hex-icon {
    width: 42px;
    height: 42px;
}

.subject-selection--narrow .subject-selection__card-title {
    font-size: 26px;
}

.subject-selection--narrow .subject-selection__card-desc {
    font-size: 15px;
    max-width: 250px;
}

.subject-selection--narrow .subject-selection__progress-pct,
.subject-selection--narrow .subject-selection__stat-label {
    font-size: 16px;
}

.subject-selection--narrow .subject-selection__stats {
    margin-bottom: 20px;
}

.subject-selection--narrow .subject-selection__cta {
    height: 52px;
    min-height: 52px;
    max-height: 52px;
    padding: 0 16px 0 20px;
    border-radius: 16px;
}

.subject-selection--narrow .subject-selection__cta-label {
    font-size: 16px;
}
