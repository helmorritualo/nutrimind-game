/* LoginPanel — 1920×1080 edge-to-edge (no outer frame), 60/40 split,
   larger form + illustration, centered brand + centered Log In label. */

.login-panel {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-surface);
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
}

.login-panel__card {
    flex-direction: row;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-surface);
    border-radius: 0;
    border-width: 0;
    overflow: hidden;
    padding: 0;
    margin: 0;
}

/* ---- LEFT 60% ---- */
.login-panel__form {
    flex-grow: 0;
    flex-shrink: 0;
    width: 60%;
    padding: 48px 72px;
    justify-content: center;
    align-items: center;
}

.login-panel__form-stack {
    width: 100%;
    max-width: 760px;
    flex-shrink: 0;
    align-items: stretch;
}

.login-panel__brand {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    align-self: center;
    margin-bottom: 40px;
}

.login-panel__brand-nutri {
    font-size: 48px;
    color: var(--nm-brand-green);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    letter-spacing: -0.6px;
}

.login-panel__brand-mind-wrap {
    flex-direction: row;
    align-items: flex-end;
    position: relative;
}

.login-panel__brand-mind {
    font-size: 48px;
    color: var(--nm-brand-blue);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    letter-spacing: -0.6px;
}

.login-panel__brand-leaf {
    position: absolute;
    width: 18px;
    height: 18px;
    right: 6px;
    top: -2px;
    -unity-background-image-tint-color: var(--nm-brand-green);
}

.login-panel__title {
    font-size: 48px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    margin: 0 0 14px 0;
    padding: 0;
    white-space: normal;
    letter-spacing: -0.5px;
}

.login-panel__subtitle {
    font-size: 20px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    margin: 0 0 40px 0;
    padding: 0;
    white-space: normal;
}

.login-panel__field {
    margin-bottom: 22px;
}

.login-panel__label {
    font-size: 17px;
    color: var(--color-text-primary);
    margin: 0 0 12px 0;
    padding: 0;
    -unity-font-style: bold;
}

.login-panel__input-shell {
    flex-direction: row;
    align-items: center;
    height: 72px;
    min-height: 72px;
    background-color: var(--color-surface);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: 16px;
    padding-left: 26px;
    padding-right: 14px;
}

.login-panel__input-shell:hover {
    border-color: var(--color-border-strong);
}

.login-panel__input-shell.is-focused {
    border-color: var(--color-primary);
}

.login-panel__input-icon {
    width: 24px;
    height: 24px;
    margin-right: 16px;
    -unity-background-image-tint-color: #757575;
}

.login-panel__input-icon--trail {
    margin-right: 0;
}

.login-panel__input {
    flex-grow: 1;
    height: 100%;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

.login-panel__input .unity-text-input,
.login-panel__input .unity-text-field__input,
.login-panel__input .unity-base-text-field__input,
.login-panel__input .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding-left: 0;
    padding-right: 4px;
    font-size: 20px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    --unity-cursor-color: var(--color-text-primary);
    --unity-selection-color: rgba(76, 175, 80, 0.28);
}

.login-panel__input .unity-base-text-field__placeholder,
.login-panel__input .unity-text-field__placeholder {
    color: #8A8A8A;
    font-size: 20px;
    -unity-font-style: bold;
}

.login-panel__input .unity-base-field__label,
.login-panel__input .unity-base-text-field__label,
.login-panel__input .unity-text-field__label {
    display: none;
    width: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
}

.login-panel__pin-toggle {
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.login-panel__pin-toggle:hover {
    background-color: var(--color-surface-hover);
    border-radius: 12px;
}

.login-panel__error {
    flex-direction: row;
    align-items: center;
    background-color: var(--nm-error-bg);
    border-width: 2px;
    border-color: var(--nm-error-border);
    border-radius: 14px;
    padding: 16px 18px;
    margin-top: 4px;
    margin-bottom: 22px;
    min-height: 60px;
}

.login-panel__error-icon {
    width: 24px;
    height: 24px;
    margin-right: 14px;
    -unity-background-image-tint-color: var(--color-danger);
}

.login-panel__error-text {
    flex-grow: 1;
    font-size: 17px;
    color: var(--color-danger);
    -unity-font-style: bold;
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* Centered icon + "Log In"; chevron pinned to the right */
.login-panel__login-btn {
    position: relative;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 72px;
    min-height: 72px;
    margin: 0 0 22px 0;
    padding: 0 72px;
    background-color: var(--color-primary);
    border-width: 0;
    border-radius: 16px;
    color: var(--color-text-on-accent);
}

.login-panel__login-btn:hover {
    background-color: var(--color-primary-hover);
}

.login-panel__login-btn:active {
    background-color: var(--color-primary-press);
}

.login-panel__login-btn-main {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
}

.login-panel__login-btn-icon {
    width: 24px;
    height: 24px;
    margin-right: 12px;
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.login-panel__login-btn-label {
    margin: 0;
    padding: 0;
    font-size: 22px;
    color: var(--color-text-on-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.login-panel__login-btn-chevron {
    position: absolute;
    right: 24px;
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.login-panel__form-footer {
    margin-top: 4px;
    align-items: flex-start;
    flex-shrink: 0;
}

.login-panel__forgot {
    align-self: flex-start;
    margin: 0;
    padding: 10px 4px;
    height: auto;
    min-height: 44px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: var(--nm-brand-blue);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.login-panel__forgot:hover {
    color: var(--color-secondary-hover);
    background-color: rgba(0, 0, 0, 0);
}

.login-panel__divider {
    width: 1px;
    flex-shrink: 0;
    align-self: stretch;
    background-color: var(--color-border);
    margin-top: 56px;
    margin-bottom: 56px;
}

/* ---- RIGHT 40% ---- */
.login-panel__visual {
    flex-grow: 1;
    flex-basis: 0;
    width: 40%;
    background-color: var(--color-surface);
    padding: 56px 48px 48px 40px;
    justify-content: center;
    align-items: center;
}

.login-panel__visual-main {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.login-panel__illustration-glow {
    width: 460px;
    height: 460px;
    border-radius: 230px;
    background-color: var(--nm-illustration-glow);
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: visible;
    margin-bottom: 32px;
}

.login-panel__leaf {
    position: absolute;
    width: 44px;
    height: 44px;
    opacity: 0.42;
    -unity-background-image-tint-color: var(--color-primary);
}

.login-panel__leaf--1 { top: 36px; left: 20px; }
.login-panel__leaf--2 { top: 150px; left: -10px; }
.login-panel__leaf--3 { top: 280px; left: 28px; }
.login-panel__leaf--4 { top: 44px; right: 12px; }
.login-panel__leaf--5 { top: 250px; right: -4px; }

.login-panel__illustration-placeholder {
    width: 260px;
    height: 340px;
    border-radius: 22px;
    background-color: rgba(76, 175, 80, 0.14);
    border-width: 2px;
    border-color: rgba(76, 175, 80, 0.30);
    align-items: center;
    justify-content: center;
    padding: 18px;
}

.login-panel__illustration-label {
    font-size: 15px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.login-panel__tip {
    flex-direction: row;
    align-items: center;
    width: 100%;
    max-width: 520px;
    background-color: var(--nm-tip-bg);
    border-width: 2px;
    border-color: var(--nm-tip-border);
    border-radius: 16px;
    padding: 20px 22px;
    min-height: 76px;
    flex-shrink: 0;
    align-self: center;
}

.login-panel__tip-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: var(--color-secondary-soft);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    flex-shrink: 0;
}

.login-panel__tip-icon {
    width: 20px;
    height: 20px;
    -unity-background-image-tint-color: var(--color-secondary);
}

.login-panel__tip-text {
    flex-grow: 1;
    font-size: 17px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* ---- Compact ---- */
.login-panel--compact .login-panel__card {
    flex-direction: column;
}

.login-panel--compact .login-panel__form {
    width: 100%;
    padding: 36px 40px;
}

.login-panel--compact .login-panel__form-stack {
    max-width: none;
}

.login-panel--compact .login-panel__divider {
    width: auto;
    height: 1px;
    margin: 0 32px;
}

.login-panel--compact .login-panel__visual {
    width: 100%;
    padding: 28px 32px 36px 32px;
    min-height: 360px;
}

.login-panel--compact .login-panel__illustration-glow {
    width: 300px;
    height: 300px;
    border-radius: 150px;
}

.login-panel--compact .login-panel__title {
    font-size: 36px;
}

.login-panel--compact .login-panel__brand-nutri,
.login-panel--compact .login-panel__brand-mind {
    font-size: 36px;
}

/* ---- Narrow ---- */
.login-panel--narrow .login-panel__form {
    padding: 24px 22px;
}

.login-panel--narrow .login-panel__brand-nutri,
.login-panel--narrow .login-panel__brand-mind {
    font-size: 30px;
}

.login-panel--narrow .login-panel__title {
    font-size: 28px;
}

.login-panel--narrow .login-panel__subtitle {
    font-size: 16px;
    margin-bottom: 24px;
}

.login-panel--narrow .login-panel__input-shell,
.login-panel--narrow .login-panel__login-btn {
    height: 56px;
    min-height: 56px;
}

.login-panel--narrow .login-panel__input .unity-text-input,
.login-panel--narrow .login-panel__input .unity-text-field__input,
.login-panel--narrow .login-panel__input .unity-base-text-field__input {
    font-size: 17px;
}

.login-panel--narrow .login-panel__login-btn-label {
    font-size: 18px;
}

.login-panel--narrow .login-panel__login-btn {
    padding: 0 56px;
}

.login-panel--narrow .login-panel__visual {
    padding: 20px 18px 24px 18px;
    min-height: 260px;
}

.login-panel--narrow .login-panel__illustration-glow {
    width: 200px;
    height: 200px;
    border-radius: 100px;
}

.login-panel--narrow .login-panel__tip {
    min-height: 64px;
    padding: 14px 16px;
}

.login-panel--narrow .login-panel__tip-text {
    font-size: 14px;
}
