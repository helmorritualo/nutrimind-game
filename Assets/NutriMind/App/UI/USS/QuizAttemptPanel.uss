/* Quiz Portal attempt route content — hosted by AppShell or standalone UIDocument preview */

.quiz-attempt-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    position: relative;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.quiz-attempt-panel.app-screen-content--embedded {
    background-color: rgba(0, 0, 0, 0);
}

.quiz-attempt-panel Label {
    margin: 0;
    padding: 0;
    white-space: normal;
    -unity-font-style: bold;
}

/* ========== SHELL ========== */
.quiz-attempt-panel__content-shell {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.quiz-attempt-panel__content-shell.quiz-attempt-panel__content-shell--hidden {
    display: none;
}

/* ========== HEADER ========== */
.quiz-attempt-panel__header {
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    margin: 24px 36px 0 36px;
    padding: 28px 32px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-attempt-panel__header-row {
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
    margin-bottom: 20px;
}

.quiz-attempt-panel__exit-button {
    flex-shrink: 0;
    min-height: 56px;
    margin: 0;
    padding: 14px 22px;
    font-size: 20px;
}

.quiz-attempt-panel__header-center {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    margin: 0 24px;
}

.quiz-attempt-panel__title {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
}

.quiz-attempt-panel__subject-term {
    margin-top: 8px;
    font-size: 20px;
    color: var(--nm-literaquest);
    -unity-text-align: middle-center;
}

.quiz-attempt-panel__question-progress-label {
    margin-top: 10px;
    font-size: 20px;
    color: var(--color-text-secondary);
    -unity-text-align: middle-center;
}

.quiz-attempt-panel__header-chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    max-width: 320px;
}

.quiz-attempt-panel__attempt-chip,
.quiz-attempt-panel__online-chip {
    flex-direction: row;
    align-items: center;
    margin: 0 0 8px 10px;
    padding: 12px 16px;
    background-color: var(--color-secondary-soft);
    border-radius: var(--radius-md);
}

.quiz-attempt-panel__online-chip {
    background-color: var(--color-primary-soft);
}

.quiz-attempt-panel__online-icon {
    width: 22px;
    height: 22px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-primary);
}

.quiz-attempt-panel__chip-label {
    font-size: 17px;
    color: var(--color-text-primary);
}

.quiz-attempt-panel__progress-bar {
    width: 100%;
    min-height: 16px;
    margin: 0;
}

/* ========== BODY SCROLL ========== */
.quiz-attempt-panel__body-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-width: 0;
    min-height: 0;
}

.quiz-attempt-panel__body {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    height: auto;
    padding: 28px 36px 36px 36px;
}

/* ========== WORKSPACE ========== */
.quiz-attempt-panel__answer-mode {
    flex-direction: column;
    width: 100%;
    min-width: 0;
}

.quiz-attempt-panel__answer-mode.quiz-attempt-panel__answer-mode--hidden {
    display: none;
}

.quiz-attempt-panel__workspace {
    flex-direction: row;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
}

.quiz-attempt-panel__question-column {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 28px;
}

.quiz-attempt-panel__navigator-column {
    flex-grow: 0;
    flex-shrink: 0;
    width: 34%;
    max-width: 400px;
    min-width: 320px;
}

.quiz-attempt-panel__question-card {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    padding: 36px 40px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-attempt-panel__question-meta {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 18px;
}

.quiz-attempt-panel__question-number {
    font-size: 22px;
    color: var(--color-text-secondary);
    margin-right: 14px;
}

.quiz-attempt-panel__question-type {
    font-size: 18px;
    color: var(--color-secondary);
    padding: 8px 14px;
    background-color: var(--color-secondary-soft);
    border-radius: var(--radius-sm);
}

.quiz-attempt-panel__question-prompt {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--color-text-primary);
    margin-bottom: 14px;
    white-space: normal;
}

.quiz-attempt-panel__selection-instruction {
    font-size: 20px;
    color: var(--color-text-secondary);
    margin-bottom: 24px;
}

.quiz-attempt-panel__options-host {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    margin-top: 4px;
}

/* Options — selected is neutral emphasis, never correctness */
.quiz-attempt-panel__option {
    flex-direction: row;
    align-items: center;
    width: 100%;
    min-height: 76px;
    margin: 0 0 16px 0;
    padding: 18px 24px;
    background-color: var(--color-surface-elev);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
}

.quiz-attempt-panel__option:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-strong);
}

.quiz-attempt-panel__option:focus {
    border-color: var(--color-secondary);
}

.quiz-attempt-panel__option:checked,
.quiz-attempt-panel__option.quiz-attempt-panel__option--selected {
    background-color: var(--color-primary-soft);
    border-color: var(--color-primary);
}

.quiz-attempt-panel__option Label,
.quiz-attempt-panel__option .unity-base-field__label,
.quiz-attempt-panel__option .unity-toggle__text,
.quiz-attempt-panel__option .unity-radio-button__text {
    font-size: 24px;
    color: var(--color-text-primary);
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 14px;
    padding-left: 4px;
}

.quiz-attempt-panel__option .unity-radio-button__checkmark-background,
.quiz-attempt-panel__option .unity-toggle__checkmark {
    flex-shrink: 0;
    margin-right: 4px;
}

.quiz-attempt-panel__option:disabled {
    opacity: 0.55;
}

/* ========== NAVIGATOR ========== */
.quiz-attempt-panel__navigator-card {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    padding: 28px 30px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-attempt-panel__navigator-title {
    font-size: 24px;
    color: var(--color-text-primary);
    margin-bottom: 20px;
}

.quiz-attempt-panel__summary-rows {
    flex-direction: column;
    width: 100%;
    margin-bottom: 22px;
}

.quiz-attempt-panel__summary-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.quiz-attempt-panel__summary-label {
    font-size: 19px;
    color: var(--color-text-secondary);
}

.quiz-attempt-panel__summary-value {
    font-size: 19px;
    color: var(--color-text-primary);
}

.quiz-attempt-panel__question-nav-host {
    flex-direction: row;
    flex-wrap: wrap;
    width: 100%;
    margin-bottom: 18px;
}

.quiz-attempt-panel__question-nav {
    width: 60px;
    height: 60px;
    min-width: 56px;
    min-height: 56px;
    margin: 0 10px 10px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface-elev);
    border-width: 2px;
    border-color: var(--color-border);
    border-radius: var(--radius-md);
    font-size: 22px;
    color: var(--color-text-primary);
}

.quiz-attempt-panel__question-nav--unanswered {
    border-color: var(--color-border-strong);
    background-color: var(--color-surface);
    opacity: 0.92;
}

.quiz-attempt-panel__question-nav--answered {
    background-color: var(--color-secondary-soft);
    border-color: var(--color-secondary);
}

.quiz-attempt-panel__question-nav--marked {
    border-color: var(--color-warning);
    background-color: var(--color-warning-soft);
}

.quiz-attempt-panel__question-nav--current {
    border-color: var(--color-primary);
    border-width: 3px;
}

.quiz-attempt-panel__legend {
    margin-bottom: 16px;
}

.quiz-attempt-panel__legend-text {
    font-size: 16px;
    color: var(--color-text-secondary);
}

.quiz-attempt-panel__connection-note {
    font-size: 17px;
    color: var(--color-text-secondary);
    white-space: normal;
    margin-top: 4px;
}

/* ========== REVIEW MODE ========== */
.quiz-attempt-panel__review-mode {
    flex-direction: column;
    width: 100%;
    min-width: 0;
}

.quiz-attempt-panel__review-mode.quiz-attempt-panel__review-mode--hidden {
    display: none;
}

.quiz-attempt-panel__review-intro {
    flex-direction: column;
    margin-bottom: 32px;
}

.quiz-attempt-panel__review-heading {
    font-size: 34px;
    color: var(--color-text-primary);
    margin-bottom: 14px;
}

.quiz-attempt-panel__review-supporting {
    font-size: 22px;
    color: var(--color-text-secondary);
    margin-bottom: 16px;
    white-space: normal;
}

.quiz-attempt-panel__review-summary {
    font-size: 20px;
    color: var(--color-text-primary);
}

.quiz-attempt-panel__review-list {
    flex-direction: column;
    width: 100%;
    min-width: 0;
}

.quiz-attempt-panel__review-card {
    flex-direction: column;
    width: 100%;
    min-width: 0;
    margin-bottom: 24px;
    padding: 32px 36px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: var(--radius-lg);
}

.quiz-attempt-panel__review-card-number {
    font-size: 20px;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
}

.quiz-attempt-panel__review-card-prompt {
    font-size: 28px;
    color: var(--color-text-primary);
    margin-bottom: 16px;
    white-space: normal;
}

.quiz-attempt-panel__review-card-answer {
    font-size: 22px;
    color: var(--color-text-primary);
    margin-bottom: 12px;
    white-space: normal;
}

.quiz-attempt-panel__review-card-status {
    font-size: 18px;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
}

.quiz-attempt-panel__review-card-marked {
    font-size: 18px;
    color: var(--color-warning);
    margin-bottom: 18px;
}

.quiz-attempt-panel__review-edit-button {
    align-self: flex-start;
    min-height: 60px;
    margin: 14px 0 0 0;
    padding: 16px 24px;
    font-size: 20px;
}

/* ========== FOOTER ========== */
.quiz-attempt-panel__footer {
    flex-shrink: 0;
    flex-direction: column;
    width: 100%;
    min-height: 104px;
    padding: 18px 36px;
    background-color: var(--color-surface);
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.quiz-attempt-panel__answer-footer,
.quiz-attempt-panel__review-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-width: 0;
}

.quiz-attempt-panel__answer-footer.quiz-attempt-panel__answer-footer--hidden,
.quiz-attempt-panel__review-footer.quiz-attempt-panel__review-footer--hidden {
    display: none;
}

.quiz-attempt-panel__previous-button,
.quiz-attempt-panel__next-button,
.quiz-attempt-panel__back-to-questions-button,
.quiz-attempt-panel__submit-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 64px;
    margin: 0;
    padding: 16px 28px;
}

/* Mark-for-review: generous spacing so flag, checkbox, and label are not cramped */
.quiz-attempt-panel__review-toggle-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    justify-content: center;
    min-width: 0;
    margin: 0 28px;
    padding: 10px 18px;
}

.quiz-attempt-panel__review-flag-icon {
    width: 26px;
    height: 26px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-warning);
}

.quiz-attempt-panel__review-toggle {
    margin: 0;
    min-height: 56px;
    padding: 6px 4px;
}

.quiz-attempt-panel__review-toggle .unity-toggle__input {
    margin-right: 14px;
}

.quiz-attempt-panel__review-toggle .unity-base-field__label,
.quiz-attempt-panel__review-toggle .unity-toggle__text,
.quiz-attempt-panel__review-toggle .ds-check__label {
    margin-left: 14px;
    padding-left: 4px;
    font-size: 20px;
    color: var(--color-text-primary);
    white-space: normal;
}

.quiz-attempt-panel__footer-icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    margin-right: 12px;
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.quiz-attempt-panel__next-button .quiz-attempt-panel__footer-icon,
.quiz-attempt-panel__submit-button .quiz-attempt-panel__footer-icon {
    margin-right: 0;
    margin-left: 12px;
}

.quiz-attempt-panel__footer-icon--on-accent {
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

/* Nested labels — primary/secondary filled buttons use on-accent (white) */
.quiz-attempt-panel__primary-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text-on-accent);
}

/* Previous (blue secondary): white text + white icon for contrast */
.quiz-attempt-panel__previous-button.ds-btn--secondary
.quiz-attempt-panel__primary-label {
    color: var(--color-text-on-accent);
}

.quiz-attempt-panel__previous-button .quiz-attempt-panel__footer-icon {
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.quiz-attempt-panel__back-to-questions-button.ds-btn--secondary
.quiz-attempt-panel__primary-label {
    color: var(--color-text-on-accent);
}

.quiz-attempt-panel__back-to-questions-button .quiz-attempt-panel__footer-icon {
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

.quiz-attempt-panel__exit-button.ds-btn--ghost
.quiz-attempt-panel__primary-label,
.quiz-attempt-panel__review-edit-button.ds-btn--secondary
.quiz-attempt-panel__primary-label,
.quiz-attempt-panel__review-edit-button.ds-btn--ghost
.quiz-attempt-panel__primary-label {
    color: var(--color-text-primary);
}

.quiz-attempt-panel__previous-button:disabled
.quiz-attempt-panel__primary-label,
.quiz-attempt-panel__next-button:disabled
.quiz-attempt-panel__primary-label,
.quiz-attempt-panel__back-to-questions-button:disabled
.quiz-attempt-panel__primary-label,
.quiz-attempt-panel__submit-button:disabled
.quiz-attempt-panel__primary-label {
    color: var(--color-text-disabled);
}

.quiz-attempt-panel__previous-button:disabled
.quiz-attempt-panel__footer-icon,
.quiz-attempt-panel__next-button:disabled
.quiz-attempt-panel__footer-icon,
.quiz-attempt-panel__back-to-questions-button:disabled
.quiz-attempt-panel__footer-icon {
    -unity-background-image-tint-color: var(--color-text-disabled);
}

/* ========== STATE HOSTS ========== */
.quiz-attempt-panel__data-state-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    display: none;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.quiz-attempt-panel__data-state-host.quiz-attempt-panel__data-state-host--visible {
    display: flex;
}

.quiz-attempt-panel__local-modal-host {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
}

/* ========== COMPACT (< 1100) ========== */
.quiz-attempt-panel--compact .quiz-attempt-panel__header {
    margin: 20px 24px 0 24px;
    padding: 24px 26px;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__body {
    padding: 22px 24px 30px 24px;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__footer {
    padding: 16px 24px;
    min-height: 112px;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__workspace {
    flex-direction: column;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__question-column {
    width: 100%;
    margin-right: 0;
    margin-bottom: 22px;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__navigator-column {
    width: 100%;
    max-width: none;
    min-width: 0;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__title {
    font-size: 30px;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__question-prompt {
    font-size: 30px;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__option {
    min-height: 72px;
}

.quiz-attempt-panel--compact .quiz-attempt-panel__option Label,
.quiz-attempt-panel--compact .quiz-attempt-panel__option .unity-base-field__label {
    font-size: 22px;
}

/* ========== NARROW (< 820) — mobile-friendly scale ========== */
.quiz-attempt-panel--narrow .quiz-attempt-panel__header {
    margin-left: 14px;
    margin-right: 14px;
    padding: 20px 18px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__header-row {
    flex-direction: column;
    align-items: stretch;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__exit-button {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 16px;
    min-height: 56px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__header-center {
    align-items: flex-start;
    margin: 0 0 16px 0;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__title,
.quiz-attempt-panel--narrow .quiz-attempt-panel__subject-term,
.quiz-attempt-panel--narrow .quiz-attempt-panel__question-progress-label {
    -unity-text-align: middle-left;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__title {
    font-size: 28px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__subject-term,
.quiz-attempt-panel--narrow .quiz-attempt-panel__question-progress-label {
    font-size: 18px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__header-chips {
    justify-content: flex-start;
    max-width: none;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__attempt-chip,
.quiz-attempt-panel--narrow .quiz-attempt-panel__online-chip {
    margin-left: 0;
    margin-right: 10px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__body {
    padding: 18px 14px 28px 14px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__question-card {
    padding: 26px 22px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__question-prompt {
    font-size: 28px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-heading {
    font-size: 28px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-supporting {
    font-size: 18px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-card {
    padding: 26px 22px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-card-prompt {
    font-size: 24px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-card-answer {
    font-size: 20px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-edit-button {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    min-height: 56px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__selection-instruction {
    font-size: 18px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__option {
    min-height: 72px;
    padding: 16px 18px;
    margin-bottom: 14px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__option Label,
.quiz-attempt-panel--narrow .quiz-attempt-panel__option .unity-base-field__label,
.quiz-attempt-panel--narrow .quiz-attempt-panel__option .unity-toggle__text,
.quiz-attempt-panel--narrow .quiz-attempt-panel__option .unity-radio-button__text {
    font-size: 22px;
    margin-left: 12px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__navigator-card {
    padding: 24px 22px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__question-nav {
    width: 56px;
    height: 56px;
    min-width: 52px;
    min-height: 52px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__footer {
    padding: 16px 14px;
    min-height: 120px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__answer-footer,
.quiz-attempt-panel--narrow .quiz-attempt-panel__review-footer {
    flex-wrap: wrap;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-toggle-row {
    width: 100%;
    margin: 0 0 16px 0;
    padding: 12px 8px;
    justify-content: flex-start;
    flex-grow: 0;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-flag-icon {
    margin-right: 14px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__review-toggle .unity-base-field__label,
.quiz-attempt-panel--narrow .quiz-attempt-panel__review-toggle .unity-toggle__text {
    font-size: 19px;
    margin-left: 12px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__previous-button,
.quiz-attempt-panel--narrow .quiz-attempt-panel__next-button {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 60px;
    margin-left: 0;
    margin-right: 0;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__previous-button {
    margin-right: 10px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__primary-label {
    font-size: 20px;
}

.quiz-attempt-panel--narrow .quiz-attempt-panel__back-to-questions-button,
.quiz-attempt-panel--narrow .quiz-attempt-panel__submit-button {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 10px;
    min-height: 60px;
}

.quiz-attempt-panel.mobile .quiz-attempt-panel__option Label,
.quiz-attempt-panel.mobile .quiz-attempt-panel__option .unity-base-field__label {
    font-size: 22px;
}
