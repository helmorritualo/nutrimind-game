/* BootstrapPanel — full-screen cinematic startup loading (1920×1080 landscape).
   One composition: brand, status focal point, progress, optional actions.
   No card, checklist, two-column layout, AppShell chrome, or bottom nav. */

.bootstrap-panel {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    min-height: 0;
    overflow: hidden;
    background-color: var(--color-bg);
    align-items: stretch;
    justify-content: flex-start;
}

.bootstrap-panel Label {
    margin: 0;
    padding: 0;
}

/* ========== BACKGROUND ========== */
.bootstrap-panel__background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--color-bg);
}

.bootstrap-panel__background-glow {
    position: absolute;
    left: 18%;
    right: 18%;
    top: 8%;
    height: 42%;
    border-radius: 50%;
    background-color: var(--nm-illustration-glow);
    opacity: 0.55;
}

.bootstrap-panel__background-orb {
    position: absolute;
    border-radius: 50%;
    border-width: 0;
}

.bootstrap-panel__background-orb--one {
    width: 420px;
    height: 420px;
    left: -120px;
    bottom: -80px;
    background-color: var(--color-primary-soft);
    opacity: 0.7;
}

.bootstrap-panel__background-orb--two {
    width: 360px;
    height: 360px;
    right: -100px;
    top: -60px;
    background-color: var(--color-secondary-soft);
    opacity: 0.65;
}

.bootstrap-panel__background-grid {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 14%;
    bottom: 18%;
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 48px;
    opacity: 0.35;
    background-color: rgba(255, 255, 255, 0);
}

/* ========== CONTENT ========== */
.bootstrap-panel__content {
    position: relative;
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 80px 80px 96px 80px;
    min-width: 0;
    min-height: 0;
}

/* ========== BRAND ========== */
.bootstrap-panel__brand {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    flex-shrink: 0;
    margin-bottom: 0;
}

.bootstrap-panel__brand-nutri {
    font-size: 64px;
    color: var(--nm-brand-green);
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.bootstrap-panel__brand-mind-wrap {
    position: relative;
    flex-direction: row;
    align-items: flex-end;
}

.bootstrap-panel__brand-mind {
    font-size: 64px;
    color: var(--nm-brand-blue);
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.bootstrap-panel__brand-leaf {
    position: absolute;
    right: 2px;
    top: -6px;
    width: 26px;
    height: 26px;
    -unity-background-image-tint-color: var(--nm-brand-green);
}

/* ========== CENTER STATUS ========== */
.bootstrap-panel__center {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    max-width: 880px;
    min-width: 0;
    min-height: 0;
}

.bootstrap-panel__state-icon-background {
    width: 128px;
    height: 128px;
    border-radius: 64px;
    align-items: center;
    justify-content: center;
    margin-bottom: 36px;
    background-color: var(--color-primary-soft);
    border-width: 0;
    flex-shrink: 0;
}

.bootstrap-panel__state-icon-background--hidden {
    display: none;
}

.bootstrap-panel__state-icon {
    width: 56px;
    height: 56px;
    -unity-background-image-tint-color: var(--color-primary);
}

.bootstrap-panel__state-icon--hidden {
    display: none;
}

.bootstrap-panel__message {
    font-size: 28px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 8px;
    max-width: 100%;
}

.bootstrap-panel__detail {
    font-size: 20px;
    color: var(--color-text-disabled);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 100%;
}

/* ========== PROGRESS (footer) ========== */
.bootstrap-panel__progress-region {
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-end;
    flex-shrink: 0;
    width: 88%;
    max-width: 1500px;
    min-width: 0;
    align-self: center;
    margin-top: 24px;
    margin-bottom: 20px;
}

.bootstrap-panel__status {
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    margin-bottom: 22px;
}

.bootstrap-panel__progress-bar-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
}

.bootstrap-panel__progress {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 26px;
    min-height: 26px;
    max-height: 26px;
    min-width: 0;
    margin: 0;
}

.bootstrap-panel__progress .unity-progress-bar__container {
    height: 26px;
    min-height: 26px;
    max-height: 26px;
}

.bootstrap-panel__progress .unity-progress-bar__background {
    height: 26px;
    min-height: 26px;
    max-height: 26px;
    border-radius: 13px;
    background-color: var(--color-surface-hover);
    border-width: 0;
}

.bootstrap-panel__progress .unity-progress-bar__progress {
    height: 26px;
    min-height: 26px;
    max-height: 26px;
    border-radius: 13px;
}

.bootstrap-panel__progress-percent {
    flex-shrink: 0;
    flex-grow: 0;
    font-size: 26px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    margin-left: 28px;
    width: 104px;
    min-width: 104px;
}

/* ========== ACTIONS ==========
   Footer CTAs sit above status/progress so action states read as one
   bottom cluster instead of tiny floating mid-screen chips. */
.bootstrap-panel__actions {
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    flex-wrap: nowrap;
    flex-shrink: 0;
    width: 100%;
    max-width: 920px;
    min-width: 0;
    align-self: center;
    margin-bottom: 28px;
}

.bootstrap-panel__actions--hidden {
    display: none;
}

.bootstrap-panel__primary-action,
.bootstrap-panel__secondary-action {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 64px;
    min-height: 64px;
    max-height: 64px;
    min-width: 240px;
    max-width: 420px;
    margin: 0 10px;
    padding-left: 28px;
    padding-right: 28px;
    border-radius: 18px;
    border-width: 2px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.bootstrap-panel__primary-action {
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--color-primary);
    color: var(--color-text-on-accent);
}

.bootstrap-panel__primary-action:hover {
    background-color: var(--color-primary-hover);
}

.bootstrap-panel__primary-action:active {
    background-color: var(--color-primary-press);
}

.bootstrap-panel__secondary-action {
    background-color: var(--color-surface);
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
}

.bootstrap-panel__secondary-action:hover {
    background-color: var(--color-surface-elev);
    border-color: var(--color-text-secondary);
}

.bootstrap-panel__secondary-action:active {
    background-color: var(--color-surface-hover);
}

.bootstrap-panel__secondary-action--hidden {
    display: none;
}

.bootstrap-panel__actions--single .bootstrap-panel__primary-action {
    flex-grow: 0;
    flex-basis: auto;
    width: 480px;
    min-width: 320px;
    max-width: 560px;
}

/* ========== REFERENCE ========== */
.bootstrap-panel__reference {
    position: absolute;
    left: 80px;
    right: 80px;
    bottom: 32px;
    font-size: 15px;
    color: var(--color-text-disabled);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.bootstrap-panel__reference--hidden {
    display: none;
}

/* ========== TONE ========== */
.bootstrap-panel--loading .bootstrap-panel__background-glow {
    background-color: var(--nm-illustration-glow);
    opacity: 0.55;
}

.bootstrap-panel--loading .bootstrap-panel__state-icon-background {
    background-color: var(--color-primary-soft);
}

.bootstrap-panel--loading .bootstrap-panel__state-icon {
    -unity-background-image-tint-color: var(--color-primary);
}

.bootstrap-panel--loading .bootstrap-panel__progress .unity-progress-bar__progress {
    background-color: var(--color-primary);
}

.bootstrap-panel--information .bootstrap-panel__background-glow {
    background-color: var(--color-secondary-soft);
    opacity: 0.5;
}

.bootstrap-panel--information .bootstrap-panel__state-icon-background {
    background-color: var(--color-secondary-soft);
}

.bootstrap-panel--information .bootstrap-panel__state-icon {
    -unity-background-image-tint-color: var(--color-secondary);
}

.bootstrap-panel--information .bootstrap-panel__progress .unity-progress-bar__progress {
    background-color: var(--color-secondary);
}

.bootstrap-panel--success .bootstrap-panel__background-glow {
    background-color: var(--color-primary-soft);
    opacity: 0.6;
}

.bootstrap-panel--success .bootstrap-panel__state-icon-background {
    background-color: var(--color-primary-soft);
}

.bootstrap-panel--success .bootstrap-panel__state-icon {
    -unity-background-image-tint-color: var(--color-primary);
}

.bootstrap-panel--success .bootstrap-panel__message {
    color: var(--nm-brand-green);
}

.bootstrap-panel--success .bootstrap-panel__progress .unity-progress-bar__progress {
    background-color: var(--color-primary);
}

.bootstrap-panel--warning .bootstrap-panel__background-glow {
    background-color: var(--color-warning-soft);
    opacity: 0.45;
}

.bootstrap-panel--warning .bootstrap-panel__state-icon-background {
    background-color: var(--color-warning-soft);
}

.bootstrap-panel--warning .bootstrap-panel__state-icon {
    -unity-background-image-tint-color: var(--color-warning);
}

.bootstrap-panel--warning .bootstrap-panel__detail {
    color: var(--color-warning-hover);
}

.bootstrap-panel--warning .bootstrap-panel__progress .unity-progress-bar__progress {
    background-color: var(--color-warning);
}

.bootstrap-panel--error .bootstrap-panel__background-glow {
    background-color: var(--color-danger-soft);
    opacity: 0.4;
}

.bootstrap-panel--error .bootstrap-panel__state-icon-background {
    background-color: var(--color-danger-soft);
}

.bootstrap-panel--error .bootstrap-panel__state-icon {
    -unity-background-image-tint-color: var(--color-danger);
}

.bootstrap-panel--error .bootstrap-panel__detail {
    color: var(--color-danger-hover);
}

.bootstrap-panel--error .bootstrap-panel__progress .unity-progress-bar__progress {
    background-color: var(--color-danger);
}

/* ========== COMPACT (< 1100) ========== */
.bootstrap-panel--compact .bootstrap-panel__content {
    padding: 56px 56px 84px 56px;
}

.bootstrap-panel--compact .bootstrap-panel__brand-nutri,
.bootstrap-panel--compact .bootstrap-panel__brand-mind {
    font-size: 52px;
}

.bootstrap-panel--compact .bootstrap-panel__brand-leaf {
    width: 22px;
    height: 22px;
}

.bootstrap-panel--compact .bootstrap-panel__center {
    max-width: 720px;
}

.bootstrap-panel--compact .bootstrap-panel__state-icon-background {
    width: 112px;
    height: 112px;
    border-radius: 56px;
    margin-bottom: 30px;
}

.bootstrap-panel--compact .bootstrap-panel__state-icon {
    width: 48px;
    height: 48px;
}

.bootstrap-panel--compact .bootstrap-panel__message {
    font-size: 24px;
}

.bootstrap-panel--compact .bootstrap-panel__detail {
    font-size: 18px;
}

.bootstrap-panel--compact .bootstrap-panel__progress-region {
    width: 90%;
}

.bootstrap-panel--compact .bootstrap-panel__actions {
    max-width: 820px;
    margin-bottom: 24px;
}

.bootstrap-panel--compact .bootstrap-panel__primary-action,
.bootstrap-panel--compact .bootstrap-panel__secondary-action {
    height: 58px;
    min-height: 58px;
    max-height: 58px;
    min-width: 210px;
    font-size: 22px;
    border-radius: 16px;
}

.bootstrap-panel--compact .bootstrap-panel__progress-percent {
    font-size: 24px;
    width: 96px;
    min-width: 96px;
}

.bootstrap-panel--compact .bootstrap-panel__reference {
    left: 56px;
    right: 56px;
    bottom: 28px;
}

/* ========== NARROW (< 820) ========== */
.bootstrap-panel--narrow .bootstrap-panel__content {
    padding: 44px 28px 76px 28px;
}

.bootstrap-panel--narrow .bootstrap-panel__brand-nutri,
.bootstrap-panel--narrow .bootstrap-panel__brand-mind {
    font-size: 42px;
}

.bootstrap-panel--narrow .bootstrap-panel__brand-leaf {
    width: 18px;
    height: 18px;
    right: 0;
    top: -4px;
}

.bootstrap-panel--narrow .bootstrap-panel__center {
    max-width: 100%;
}

.bootstrap-panel--narrow .bootstrap-panel__state-icon-background {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin-bottom: 24px;
}

.bootstrap-panel--narrow .bootstrap-panel__state-icon {
    width: 42px;
    height: 42px;
}

.bootstrap-panel--narrow .bootstrap-panel__message {
    font-size: 20px;
}

.bootstrap-panel--narrow .bootstrap-panel__detail {
    font-size: 16px;
}

.bootstrap-panel--narrow .bootstrap-panel__progress-region {
    width: 92%;
    margin-bottom: 18px;
}

.bootstrap-panel--narrow .bootstrap-panel__progress,
.bootstrap-panel--narrow .bootstrap-panel__progress .unity-progress-bar__container,
.bootstrap-panel--narrow .bootstrap-panel__progress .unity-progress-bar__background,
.bootstrap-panel--narrow .bootstrap-panel__progress .unity-progress-bar__progress {
    height: 22px;
    min-height: 22px;
    max-height: 22px;
}

.bootstrap-panel--narrow .bootstrap-panel__progress-percent {
    font-size: 20px;
    margin-left: 16px;
    width: 72px;
    min-width: 72px;
}

.bootstrap-panel--narrow .bootstrap-panel__actions {
    flex-direction: column;
    align-items: stretch;
    max-width: 100%;
    margin-bottom: 20px;
}

.bootstrap-panel--narrow .bootstrap-panel__primary-action,
.bootstrap-panel--narrow .bootstrap-panel__secondary-action {
    margin: 6px 0;
    min-width: 0;
    max-width: none;
    width: 100%;
    height: 56px;
    min-height: 56px;
    max-height: 56px;
    font-size: 20px;
    border-radius: 16px;
}

.bootstrap-panel--narrow .bootstrap-panel__reference {
    left: 28px;
    right: 28px;
    bottom: 20px;
    font-size: 14px;
}

.bootstrap-panel--narrow .bootstrap-panel__background-orb--one {
    width: 260px;
    height: 260px;
    left: -90px;
    bottom: -70px;
}

.bootstrap-panel--narrow .bootstrap-panel__background-orb--two {
    width: 220px;
    height: 220px;
    right: -70px;
    top: -50px;
}

.bootstrap-panel--narrow .bootstrap-panel__background-grid {
    left: 4%;
    right: 4%;
    border-radius: 28px;
}
