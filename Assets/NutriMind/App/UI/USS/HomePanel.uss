/* Home route content — hosted by AppShell or standalone UIDocument preview */

.home-panel {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.home-panel.app-screen-content--embedded {
    background-color: rgba(0, 0, 0, 0);
}

/* Kill Unity Label default margins that shift / soft-overlap text */
.home-panel Label {
    margin: 0;
    padding: 0;
}

/* ========== SCROLL ========== */
.home-panel__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.home-panel__scroll > .unity-scroll-view__content-and-vertical-scroll-container {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.home-panel__scroll .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.home-panel__scroll .unity-scroll-view__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    height: auto;
}

/* ========== CONTENT ========== */
.home-panel__content {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 0;
    padding: 12px 16px 8px 16px;
}

/* ========== ANNOUNCEMENT ========== */
.home-panel__announce-bar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    min-width: 0;
    margin-bottom: 18px;
    padding: 16px 22px;
    border-radius: 18px;
    background-color: var(--color-surface-elev);
    border-width: 1px;
    border-color: var(--color-border);
}

.home-panel__announce {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.home-panel__announce-icon {
    width: 26px;
    height: 26px;
    margin-right: 12px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--nm-brand-blue);
}

.home-panel__announce-text {
    font-size: 18px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* ========== GRID ========== */
.home-panel__grid {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    min-width: 0;
}

.home-panel__row {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
}

.home-panel__row--top {
    margin-bottom: 18px;
    flex-basis: 44%;
    min-height: 250px;
}

.home-panel__row--bottom {
    flex-basis: 56%;
    min-height: 290px;
}

.home-panel__card {
    position: relative;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 28px;
    padding: 32px 36px;
    overflow: hidden;
    min-height: 0;
    min-width: 0;
}

.home-panel__card--play,
.home-panel__card--quiz {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    justify-content: center;
    padding: 32px 36px;
}

.home-panel__card--play {
    margin-right: 18px;
    background-color: #EAF6E8;
    border-color: #D7EBD2;
}

.home-panel__card--quiz {
    background-color: #F3ECFB;
    border-color: #E4D6F5;
}

.home-panel__card--journey {
    flex-grow: 1.75;
    flex-basis: 0;
    margin-right: 18px;
    flex-direction: column;
    padding: 26px 30px;
}

.home-panel__card--goal {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    padding: 26px 30px;
}

/* Soft foliage wash — bottom-right only.
   picking-mode is a UXML attribute only — never put it in USS. */
.home-panel__card-deco {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 220px;
    height: 140px;
    border-top-left-radius: 120px;
    border-bottom-right-radius: 28px;
    opacity: 0.22;
}

.home-panel__card-deco--play {
    background-color: rgba(76, 175, 80, 0.35);
}

.home-panel__card-deco--quiz {
    background-color: rgba(139, 92, 246, 0.30);
}

.home-panel__card-body {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

.home-panel__feature-icon {
    width: 128px;
    height: 128px;
    min-width: 128px;
    max-width: 128px;
    min-height: 128px;
    align-items: center;
    justify-content: center;
    margin-right: 28px;
    flex-grow: 0;
    flex-shrink: 0;
}

.home-panel__feature-icon--play {
    border-radius: 32px;
    background-color: #F7F3EA;
    border-width: 0;
}

.home-panel__feature-icon--quiz {
    border-radius: 64px;
    background-color: var(--color-tertiary);
}

.home-panel__feature-glyph {
    width: 68px;
    height: 68px;
    -unity-background-image-tint-color: var(--nm-brand-green);
}

.home-panel__feature-glyph--on-purple {
    -unity-background-image-tint-color: #FFFFFF;
}

.home-panel__feature-copy {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    max-width: 520px;
    padding: 0;
    margin: 0;
    overflow: hidden;
}

.home-panel__feature-title {
    margin: 0;
    padding: 0 0 8px 0;
    font-size: 34px;
    -unity-font-style: bold;
    white-space: nowrap;
    letter-spacing: -1px;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
}

.home-panel Label.home-panel__feature-title {
    margin: 0;
    padding: 0 0 8px 0;
}

.home-panel__feature-title--play {
    color: #1B5E20;
}

.home-panel__feature-title--quiz {
    color: #5B21B6;
}

.home-panel__feature-desc {
    margin: 0;
    padding: 0 0 20px 0;
    font-size: 19px;
    color: #3D3D3D;
    -unity-font-style: bold;
    white-space: normal;
    max-width: 460px;
    overflow: hidden;
}

.home-panel Label.home-panel__feature-desc {
    margin: 0;
    padding: 0 0 20px 0;
}

.home-panel__pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    width: auto;
    height: 58px;
    min-height: 58px;
    max-height: 58px;
    padding: 0 30px;
    border-width: 0;
    border-radius: 29px;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.home-panel__pill--green {
    background-color: var(--color-primary);
}

.home-panel__pill--green:hover {
    background-color: var(--color-primary-hover);
}

.home-panel__pill--purple {
    background-color: var(--color-tertiary);
}

.home-panel__pill--purple:hover {
    background-color: var(--color-tertiary-hover);
}

.home-panel__pill-label {
    margin: 0;
    padding: 0;
    font-size: 19px;
    color: var(--color-text-on-accent);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.home-panel Label.home-panel__pill-label {
    margin: 0 10px 0 0;
    padding: 0;
}

.home-panel__pill-chevron {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-text-on-accent);
}

/* Hide Unity Button's built-in text element when we use child Labels.
   Do not use :not() here — Unity USS rejects it as "Recursive pseudo classes". */
.home-panel__pill > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.home-panel__section-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
    flex-shrink: 0;
    height: auto;
    min-height: 32px;
}

.home-panel__section-icon {
    width: 28px;
    height: 28px;
    margin-right: 12px;
    flex-shrink: 0;
}

.home-panel__section-icon--journey {
    -unity-background-image-tint-color: var(--nm-brand-green);
}

.home-panel__section-icon--goal {
    -unity-background-image-tint-color: #E67E22;
}

.home-panel__section-title {
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.home-panel Label.home-panel__section-title {
    margin: 0;
    padding: 0;
}

.home-panel__section-title--journey {
    color: #1B5E20;
}

.home-panel__section-title--goal {
    color: #B45309;
}

.home-panel__journey-body {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    min-height: 0;
}

.home-panel__mission-box {
    flex-direction: row;
    align-items: center;
    width: 300px;
    min-width: 240px;
    max-width: 340px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: #F7F3EA;
    border-radius: 22px;
    padding: 20px 22px;
    margin-right: 26px;
}

.home-panel__mission-copy {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    min-width: 0;
    margin-right: 14px;
}

.home-panel__mission-badge {
    align-self: flex-start;
    font-size: 15px;
    color: #FFFFFF;
    background-color: var(--color-primary);
    border-radius: 14px;
    -unity-font-style: bold;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.home-panel Label.home-panel__mission-badge {
    margin: 0 0 10px 0;
    padding: 7px 16px;
}

.home-panel__mission-title {
    font-size: 24px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    white-space: normal;
}

.home-panel Label.home-panel__mission-title {
    margin: 0;
    padding: 0;
}

.home-panel__mission-sprout {
    width: 58px;
    height: 58px;
    min-width: 58px;
    min-height: 58px;
    border-radius: 29px;
    background-color: #FFFFFF;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #E5E5E5;
    flex-shrink: 0;
}

.home-panel__mission-sprout-icon {
    width: 30px;
    height: 30px;
    -unity-background-image-tint-color: var(--nm-brand-green);
}

.home-panel__progress {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 4px 4px 4px 0;
}

.home-panel__progress-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.home-panel__progress-label {
    font-size: 17px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
}

.home-panel Label.home-panel__progress-label {
    margin: 0;
    padding: 0;
}

.home-panel__progress-pct {
    font-size: 20px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.home-panel Label.home-panel__progress-pct {
    margin: 0;
    padding: 0;
}

.home-panel__progress-track {
    height: 14px;
    border-radius: 7px;
    background-color: #E8E8E8;
    margin-bottom: 14px;
    overflow: hidden;
}

.home-panel__progress-fill {
    width: 67%;
    height: 100%;
    background-color: var(--color-primary);
    border-radius: 7px;
}

.home-panel__journey-metrics {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.home-panel__journey-metric {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    min-width: 200px;
    background-color: #F7F3EA;
    border-radius: 16px;
    padding: 14px 18px;
    margin-right: 14px;
    margin-bottom: 8px;
}

.home-panel__journey-metric-head {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.home-panel__journey-metric-icon {
    width: 20px;
    height: 20px;
    margin-right: 10px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--nm-brand-green);
}

.home-panel__journey-metric-label {
    font-size: 16px;
    color: #3D3D3D;
    -unity-font-style: bold;
    white-space: nowrap;
}

.home-panel__journey-metric-value {
    font-size: 20px;
    color: #1B5E20;
    -unity-font-style: bold;
    white-space: nowrap;
}

.home-panel__goal-body {
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
    min-height: 0;
    padding: 4px 0;
}

.home-panel__goal-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    font-size: 20px;
    color: #3D3D3D;
    -unity-font-style: bold;
    white-space: normal;
    max-width: 400px;
}

.home-panel Label.home-panel__goal-text {
    margin: 0 20px 0 0;
    padding: 0;
}

.home-panel__goal-star {
    width: 116px;
    height: 116px;
    min-width: 116px;
    min-height: 116px;
    border-radius: 24px;
    background-color: #F7F3EA;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.home-panel__goal-star-icon {
    width: 76px;
    height: 76px;
    -unity-background-image-tint-color: #E67E22;
}

/* ========== RESPONSIVE: compact < 1100 ========== */
.home-panel--compact .home-panel__content {
    padding: 16px 20px;
}

.home-panel--compact .home-panel__announce-bar {
    margin-bottom: 14px;
    padding: 10px 14px;
}

.home-panel--compact .home-panel__announce-text {
    white-space: normal;
}

.home-panel--compact .home-panel__row--top {
    margin-bottom: 14px;
    min-height: 180px;
}

.home-panel--compact .home-panel__row--bottom {
    min-height: 220px;
}

.home-panel--compact .home-panel__card--play,
.home-panel--compact .home-panel__card--quiz {
    padding: 20px 22px;
}

.home-panel--compact .home-panel__card--play {
    margin-right: 14px;
}

.home-panel--compact .home-panel__card--journey {
    margin-right: 14px;
    padding: 18px 20px;
}

.home-panel--compact .home-panel__card--goal {
    padding: 18px 20px;
}

.home-panel--compact .home-panel__feature-title {
    font-size: 24px;
}

.home-panel--compact Label.home-panel__feature-title {
    padding-bottom: 4px;
}

.home-panel--compact .home-panel__feature-desc {
    font-size: 15px;
    max-width: 100%;
}

.home-panel--compact Label.home-panel__feature-desc {
    padding-bottom: 12px;
}

.home-panel--compact .home-panel__feature-icon {
    width: 88px;
    height: 88px;
    min-width: 88px;
    max-width: 88px;
    min-height: 88px;
    margin-right: 16px;
}

.home-panel--compact .home-panel__feature-icon--play {
    border-radius: 22px;
}

.home-panel--compact .home-panel__feature-icon--quiz {
    border-radius: 44px;
}

.home-panel--compact .home-panel__feature-glyph {
    width: 48px;
    height: 48px;
}

.home-panel--compact .home-panel__pill {
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    padding: 0 20px;
    border-radius: 24px;
}

.home-panel--compact .home-panel__pill-label {
    font-size: 15px;
}

.home-panel--compact .home-panel__journey-body {
    flex-direction: column;
    align-items: stretch;
}

.home-panel--compact .home-panel__mission-box {
    width: auto;
    max-width: none;
    margin-right: 0;
    margin-bottom: 12px;
    padding: 14px 16px;
}

.home-panel--compact .home-panel__section-head {
    margin-bottom: 10px;
}

.home-panel--compact .home-panel__goal-star {
    width: 84px;
    height: 84px;
    min-width: 84px;
    min-height: 84px;
    border-radius: 18px;
}

.home-panel--compact .home-panel__goal-star-icon {
    width: 52px;
    height: 52px;
}

.home-panel--compact Label.home-panel__goal-text {
    font-size: 15px;
    margin-right: 12px;
}

/* ========== RESPONSIVE: narrow < 820 ========== */
.home-panel--narrow .home-panel__row--top,
.home-panel--narrow .home-panel__row--bottom {
    flex-direction: column;
    flex-basis: auto;
    min-height: 0;
}

.home-panel--narrow .home-panel__card--play,
.home-panel--narrow .home-panel__card--journey {
    margin-right: 0;
    margin-bottom: 14px;
}

.home-panel--narrow .home-panel__card--play,
.home-panel--narrow .home-panel__card--quiz {
    min-height: 180px;
}

.home-panel--narrow .home-panel__feature-title {
    font-size: 22px;
}

.home-panel--narrow Label.home-panel__feature-title {
    padding-bottom: 4px;
}

.home-panel--narrow .home-panel__feature-desc {
    font-size: 14px;
}

.home-panel--narrow Label.home-panel__feature-desc {
    padding-bottom: 12px;
}

.home-panel--narrow .home-panel__feature-icon {
    width: 76px;
    height: 76px;
    min-width: 76px;
    max-width: 76px;
    min-height: 76px;
    margin-right: 14px;
}

.home-panel--narrow .home-panel__feature-icon--play {
    border-radius: 18px;
}

.home-panel--narrow .home-panel__feature-icon--quiz {
    border-radius: 38px;
}

.home-panel--narrow .home-panel__feature-glyph {
    width: 40px;
    height: 40px;
}

.home-panel--narrow .home-panel__pill {
    height: 48px;
    min-height: 48px;
    max-height: 48px;
    padding: 0 18px;
    border-radius: 24px;
}

.home-panel--narrow .home-panel__pill-label {
    font-size: 15px;
}

.home-panel--narrow .home-panel__goal-star {
    width: 76px;
    height: 76px;
    min-width: 76px;
    min-height: 76px;
    border-radius: 16px;
}

.home-panel--narrow .home-panel__goal-star-icon {
    width: 46px;
    height: 46px;
}

.home-panel--narrow Label.home-panel__goal-text {
    font-size: 14px;
    margin-right: 10px;
}
