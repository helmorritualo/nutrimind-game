/* Locked Mission — 1920×1080 landscape, matched to LockedMissionScreen design reference */

.locked-mission {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: column;
    background-color: var(--color-bg);
    padding: 0;
    margin: 0;
}

.locked-mission Label {
    margin: 0;
    padding: 0;
}

.locked-mission Label.locked-mission__summary-title,
.locked-mission Label.locked-mission__summary-desc,
.locked-mission Label.locked-mission__panel-heading,
.locked-mission Label.locked-mission__panel-subheading,
.locked-mission Label.locked-mission__detail-row-label,
.locked-mission Label.locked-mission__detail-row-value,
.locked-mission Label.locked-mission__info-text,
.locked-mission Label.locked-mission__locked-pill-label,
.locked-mission Label.locked-mission__action-primary-label {
    -unity-font-style: bold;
}

/* ========== ROUTE INTRO ========== */
.locked-mission__intro {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    min-height: 84px;
    padding: 20px 36px 8px 36px;
}

.locked-mission__intro-title {
    margin-left: 20px;
    font-size: 30px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
}

.locked-mission__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    min-height: 0;
    overflow: hidden;
}

.locked-mission__scroll > .unity-scroll-view__content-and-vertical-scroll-container,
.locked-mission__scroll .unity-scroll-view__content-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.locked-mission__scroll .unity-scroll-view__content-container {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: auto;
}

.locked-mission__back {
    width: 52px;
    height: 52px;
    min-width: 52px;
    min-height: 52px;
    max-width: 52px;
    max-height: 52px;
    padding: 0;
    margin: 0 20px 0 0;
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 16px;
    background-color: var(--color-surface);
    align-items: center;
    justify-content: center;
}

.locked-mission__back:hover {
    background-color: var(--color-surface-hover);
}

.locked-mission__back > .unity-button__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
    font-size: 0;
    color: rgba(0, 0, 0, 0);
}

.locked-mission__back-icon {
    width: 24px;
    height: 24px;
    -unity-background-image-tint-color: var(--color-text-primary);
}


/* ========== BODY ========== */
.locked-mission__body {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 12px 36px 20px 36px;
}

/* ----- Left summary panel (~28%) ----- */
.locked-mission__summary {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 28%;
    width: 28%;
    min-width: 0;
    min-height: 0;
    margin-right: 24px;
    padding: 44px 36px 40px 36px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 24px;
}

.locked-mission__lock-visual {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 36px;
}

.locked-mission__lock-leaf {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-primary);
}

.locked-mission__lock-leaf--left {
    margin-right: 18px;
}

.locked-mission__lock-leaf--right {
    margin-left: 18px;
}

.locked-mission__lock-circle {
    width: 128px;
    height: 128px;
    min-width: 128px;
    min-height: 128px;
    align-items: center;
    justify-content: center;
    border-radius: 64px;
    background-color: #ECEEF1;
}

.locked-mission__lock-icon {
    width: 56px;
    height: 56px;
    -unity-background-image-tint-color: #6B7280;
}

.locked-mission__summary-title {
    margin: 0 0 18px 0;
    padding: 0 8px;
    font-size: 36px;
    color: var(--color-text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
}

.locked-mission__summary-desc {
    margin: 0 0 36px 0;
    padding: 0 12px;
    font-size: 18px;
    color: #4B5563;
    -unity-text-align: middle-center;
    white-space: normal;
}

.locked-mission__locked-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 36px;
    background-color: #ECEEF1;
    border-radius: 28px;
}

.locked-mission__locked-pill-label {
    font-size: 18px;
    color: #6B7280;
    -unity-text-align: middle-center;
    white-space: nowrap;
}

/* ----- Right content stack ----- */
.locked-mission__content-stack {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.locked-mission__content-stack > * {
    margin-bottom: 16px;
}

/* Exact lock reason banner */
.locked-mission__info-banner {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 100%;
    padding: 20px 24px;
    background-color: rgba(30, 136, 229, 0.12);
    border-width: 1px;
    border-color: rgba(30, 136, 229, 0.22);
    border-radius: 16px;
}

.locked-mission__info-icon {
    width: 26px;
    height: 26px;
    min-width: 26px;
    min-height: 26px;
    margin-right: 16px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-secondary);
}

.locked-mission__info-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 19px;
    color: #374151;
    white-space: normal;
}

/* ----- Lock details panel ----- */
.locked-mission__details {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding: 32px 32px 28px 32px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 24px;
}

.locked-mission__panel-heading {
    margin: 0 0 8px 0;
    padding: 0;
    font-size: 32px;
    color: var(--color-text-primary);
    white-space: nowrap;
}

.locked-mission__panel-subheading {
    margin: 0 0 24px 0;
    padding: 0;
    font-size: 18px;
    color: #5C6370;
    white-space: normal;
}

.locked-mission__details-list {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.locked-mission__detail-row {
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
    padding: 16px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
}

.locked-mission__detail-row--last {
    border-bottom-width: 0;
}

.locked-mission__detail-row-icon {
    width: 26px;
    height: 26px;
    min-width: 26px;
    min-height: 26px;
    margin-right: 18px;
    margin-top: 2px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-secondary);
}

.locked-mission__detail-row-copy {
    flex-direction: column;
    align-items: flex-start;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.locked-mission__detail-row-label {
    font-size: 15px;
    color: #9CA3AF;
    letter-spacing: 0.4px;
    white-space: nowrap;
}

.locked-mission__detail-row-value {
    margin-top: 4px;
    font-size: 20px;
    color: var(--color-text-primary);
    white-space: normal;
}

/* ----- Recommended action ----- */
.locked-mission__actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    width: 100%;
    margin-bottom: 0;
}

.locked-mission__action-primary {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 68px;
    min-height: 68px;
    max-height: 68px;
    padding: 0 32px;
    border-radius: 20px;
}

.locked-mission__action-primary.ds-btn--ghost {
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
}

.locked-mission__action-primary.ds-btn--ghost:hover {
    background-color: var(--color-surface-hover);
}

.locked-mission__action-primary.ds-btn--primary {
    background-color: var(--color-primary);
    border-width: 0;
}

.locked-mission__action-primary.ds-btn--primary:hover {
    background-color: var(--color-primary-hover);
}

.locked-mission__action-primary > .unity-button__text {
    display: none;
}

.locked-mission__action-primary-label {
    font-size: 20px;
    white-space: nowrap;
    margin-right: 10px;
}

.locked-mission__action-primary.ds-btn--ghost .locked-mission__action-primary-label {
    color: var(--color-text-primary);
}

.locked-mission__action-primary.ds-btn--primary .locked-mission__action-primary-label {
    color: #FFFFFF;
}

.locked-mission__action-primary-icon {
    width: 22px;
    height: 22px;
}

.locked-mission__action-primary.ds-btn--ghost .locked-mission__action-primary-icon {
    -unity-background-image-tint-color: var(--color-text-primary);
}

.locked-mission__action-primary.ds-btn--primary .locked-mission__action-primary-icon {
    -unity-background-image-tint-color: #FFFFFF;
}


/* ========== RESPONSIVE ========== */
.locked-mission--compact .locked-mission__intro {
    min-height: 72px;
    padding: 16px 24px 6px 24px;
}

.locked-mission--compact .locked-mission__body {
    padding: 10px 24px 16px 24px;
}

.locked-mission--compact .locked-mission__summary {
    padding: 36px 28px 32px 28px;
    margin-right: 18px;
}

.locked-mission--compact .locked-mission__lock-visual {
    margin-bottom: 28px;
}

.locked-mission--compact .locked-mission__lock-circle {
    width: 108px;
    height: 108px;
    min-width: 108px;
    min-height: 108px;
    border-radius: 54px;
}

.locked-mission--compact .locked-mission__lock-icon {
    width: 46px;
    height: 46px;
}

.locked-mission--compact .locked-mission__summary-title {
    font-size: 30px;
    margin-bottom: 14px;
}

.locked-mission--compact .locked-mission__summary-desc {
    margin-bottom: 28px;
    font-size: 16px;
}

.locked-mission--compact .locked-mission__info-banner {
    padding: 16px 20px;
}

.locked-mission--compact .locked-mission__info-text {
    font-size: 17px;
}

.locked-mission--compact .locked-mission__details {
    padding: 24px 24px 20px 24px;
}

.locked-mission--compact .locked-mission__panel-heading {
    font-size: 26px;
}

.locked-mission--compact .locked-mission__detail-row-value {
    font-size: 18px;
}

.locked-mission--compact .locked-mission__action-primary {
    height: 60px;
    min-height: 60px;
    max-height: 60px;
}

.locked-mission--compact .locked-mission__action-primary-label {
    font-size: 18px;
}


/* Narrow — stack panels vertically */
.locked-mission--narrow .locked-mission__body {
    flex-direction: column;
    padding: 14px 16px 12px 16px;
}

.locked-mission--narrow .locked-mission__summary {
    flex-basis: auto;
    width: 100%;
    margin-right: 0;
    margin-bottom: 16px;
    padding: 24px 20px 20px 20px;
}

.locked-mission--narrow .locked-mission__content-stack > * {
    margin-bottom: 12px;
}

.locked-mission--narrow .locked-mission__info-banner {
    padding: 14px 16px;
}

.locked-mission--narrow .locked-mission__info-text {
    font-size: 15px;
}

.locked-mission--narrow .locked-mission__details {
    padding: 20px 18px 18px 18px;
}

.locked-mission--narrow .locked-mission__detail-row {
    padding: 12px 0;
}

.locked-mission--narrow .locked-mission__detail-row-value {
    font-size: 16px;
}

.locked-mission--narrow .locked-mission__action-primary {
    height: 56px;
    min-height: 56px;
    max-height: 56px;
}

.locked-mission--narrow .locked-mission__action-primary-label {
    font-size: 16px;
}

