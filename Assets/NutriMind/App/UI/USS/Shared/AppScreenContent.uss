/* Shared sizing contract for content-only application screens hosted by AppShell. */

.app-screen-content {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.app-screen-content--embedded {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.app-screen-content__scroll {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.app-screen-content__body {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.app-screen-content--compact {
    min-width: 0;
    min-height: 0;
}

.app-screen-content--narrow {
    min-width: 0;
    min-height: 0;
}
