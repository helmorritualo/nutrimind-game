/* OfflineSyncBanner — reusable non-modal shell status strip (1920×1080 landscape) */

.offline-sync-banner {
    width: 100%;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    min-height: 0;
}

.offline-sync-banner Label {
    margin: 0;
    padding: 0;
}

.offline-sync-banner--hidden {
    display: none;
}

/* ========== SURFACE ========== */
.offline-sync-banner__surface {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    min-height: 72px;
    padding: 14px 40px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border-strong);
    background-color: var(--color-secondary-soft);
    min-width: 0;
}

/* ========== ICON ========== */
.offline-sync-banner__icon-background {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin-right: 14px;
    border-radius: 12px;
    background-color: var(--color-surface);
    border-width: 1px;
    border-color: var(--color-border);
}

.offline-sync-banner__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    -unity-background-image-tint-color: var(--color-secondary);
}

.offline-sync-banner__icon--hidden {
    display: none;
}

.offline-sync-banner__spinner {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

.offline-sync-banner__spinner--hidden {
    display: none;
}

/* ========== COPY ========== */
.offline-sync-banner__copy {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 16px;
}

.offline-sync-banner__title {
    font-size: 16px;
    color: var(--color-text-primary);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    margin-bottom: 2px;
}

.offline-sync-banner__message {
    font-size: 15px;
    color: var(--color-text-secondary);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.offline-sync-banner__detail {
    font-size: 13px;
    color: var(--color-text-disabled);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    margin-top: 4px;
}

.offline-sync-banner__detail--hidden {
    display: none;
}

/* ========== ACTIONS ========== */
.offline-sync-banner__actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
    flex-grow: 0;
}

.offline-sync-banner__action {
    min-height: 44px;
    min-width: 120px;
    margin-right: 4px;
}

.offline-sync-banner__action--hidden {
    display: none;
}

.offline-sync-banner__dismiss {
    min-width: 44px;
    min-height: 44px;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: 0;
}

.offline-sync-banner__dismiss--hidden {
    display: none;
}

/* ========== STATE TONES ========== */
.offline-sync-banner--offline-cached .offline-sync-banner__surface {
    background-color: var(--color-warning-soft);
    border-bottom-color: var(--color-warning);
}

.offline-sync-banner--offline-cached .offline-sync-banner__icon {
    -unity-background-image-tint-color: var(--color-warning);
}

.offline-sync-banner--sync-pending .offline-sync-banner__surface {
    background-color: var(--color-tertiary-soft);
    border-bottom-color: var(--color-tertiary);
}

.offline-sync-banner--sync-pending .offline-sync-banner__icon {
    -unity-background-image-tint-color: var(--color-tertiary);
}

.offline-sync-banner--syncing .offline-sync-banner__surface {
    background-color: var(--color-secondary-soft);
    border-bottom-color: var(--color-secondary);
}

.offline-sync-banner--sync-error .offline-sync-banner__surface {
    background-color: var(--color-danger-soft);
    border-bottom-color: var(--color-danger);
}

.offline-sync-banner--sync-error .offline-sync-banner__icon {
    -unity-background-image-tint-color: var(--color-danger);
}

.offline-sync-banner--back-online .offline-sync-banner__surface {
    background-color: var(--color-primary-soft);
    border-bottom-color: var(--color-primary);
}

.offline-sync-banner--back-online .offline-sync-banner__icon {
    -unity-background-image-tint-color: var(--color-primary);
}

/* ========== RESPONSIVE: compact < 1100 ========== */
.offline-sync-banner--compact .offline-sync-banner__surface {
    padding: 12px 24px;
    min-height: 68px;
}

.offline-sync-banner--compact .offline-sync-banner__icon-background {
    margin-right: 12px;
}

.offline-sync-banner--compact .offline-sync-banner__title {
    font-size: 15px;
}

.offline-sync-banner--compact .offline-sync-banner__message {
    font-size: 14px;
}

.offline-sync-banner--compact .offline-sync-banner__detail {
    font-size: 12px;
}

.offline-sync-banner--compact .offline-sync-banner__copy {
    margin-right: 12px;
}

/* ========== RESPONSIVE: narrow < 820 ========== */
.offline-sync-banner--narrow .offline-sync-banner__surface,
.offline-sync-banner.mobile .offline-sync-banner__surface {
    flex-wrap: wrap;
    padding: 12px 16px;
    min-height: 64px;
    align-items: flex-start;
}

.offline-sync-banner--narrow .offline-sync-banner__icon-background,
.offline-sync-banner.mobile .offline-sync-banner__icon-background {
    margin-right: 10px;
    margin-top: 2px;
}

.offline-sync-banner--narrow .offline-sync-banner__copy,
.offline-sync-banner.mobile .offline-sync-banner__copy {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 0;
    margin-bottom: 8px;
}

.offline-sync-banner--narrow .offline-sync-banner__actions,
.offline-sync-banner.mobile .offline-sync-banner__actions {
    width: 100%;
    flex-wrap: wrap;
    justify-content: flex-start;
    margin-top: 2px;
}

.offline-sync-banner--narrow .offline-sync-banner__action,
.offline-sync-banner.mobile .offline-sync-banner__action {
    flex-grow: 1;
    min-width: 140px;
    margin-right: 8px;
    margin-bottom: 4px;
}

.offline-sync-banner--narrow .offline-sync-banner__dismiss,
.offline-sync-banner.mobile .offline-sync-banner__dismiss {
    margin-bottom: 4px;
}

.offline-sync-banner--narrow .offline-sync-banner__title,
.offline-sync-banner.mobile .offline-sync-banner__title {
    font-size: 15px;
}

.offline-sync-banner--narrow .offline-sync-banner__message,
.offline-sync-banner.mobile .offline-sync-banner__message {
    font-size: 14px;
}
