<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.sinanata.designsystem/Resources/UI/Styles/DesignSystem/DesignSystem.uss" />
    <Style src="project://database/Assets/NutriMind/App/UI/USS/NutriMindTheme.uss" />
    <Style src="project://database/Assets/NutriMind/App/UI/USS/Shared/AppScreenContent.uss" />
    <Style src="project://database/Assets/NutriMind/App/UI/USS/LockedMissionPanel.uss" />
    <ui:VisualElement name="locked-mission-root" class="ds-root theme-nutrimind app-screen-content locked-mission">
        <ui:VisualElement class="locked-mission__intro">
            <ui:Button name="back-button" text="" class="ds-btn ds-btn--ghost locked-mission__back" tooltip="Back">
                <ui:VisualElement class="ds-icon ds-icon--arrow-left locked-mission__back-icon" />
            </ui:Button>
            <ui:Label text="Mission unavailable" class="locked-mission__intro-title" />
        </ui:VisualElement>
        <ui:ScrollView
            name="locked-mission-scroll"
            class="app-screen-content__scroll locked-mission__scroll"
            mode="Vertical"
            horizontal-scroller-visibility="Hidden"
            vertical-scroller-visibility="Auto"
            mouse-wheel-scroll-size="72"
            vertical-page-size="0.85"
            touch-scroll-type="Clamped"
            focusable="true">
            <ui:VisualElement name="locked-body" class="locked-mission__body">
                <ui:VisualElement name="summary-panel" class="locked-mission__summary ds-card ds-card--flush">
                <ui:VisualElement class="locked-mission__lock-visual">
                    <ui:VisualElement class="ds-icon ds-icon--leaf locked-mission__lock-leaf locked-mission__lock-leaf--left" />
                    <ui:VisualElement class="locked-mission__lock-circle"><ui:VisualElement name="summary-icon" class="ds-icon ds-icon--lock locked-mission__lock-icon" /></ui:VisualElement>
                    <ui:VisualElement class="ds-icon ds-icon--leaf locked-mission__lock-leaf locked-mission__lock-leaf--right" />
                </ui:VisualElement>
                <ui:Label name="summary-title" text="Ecosystems and Balance" class="locked-mission__summary-title" />
                <ui:Label name="summary-description" text="Discover how living things depend on each other within an ecosystem." class="locked-mission__summary-desc" />
                <ui:VisualElement class="locked-mission__locked-pill"><ui:Label name="status-pill-label" text="Locked by Teacher" class="locked-mission__locked-pill-label" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="content-stack" class="locked-mission__content-stack">
                <ui:VisualElement name="lock-message-banner" class="locked-mission__info-banner">
                    <ui:VisualElement name="banner-icon" class="ds-icon ds-icon--lock locked-mission__info-icon" />
                    <ui:Label name="lock-message" text="This mission is currently locked by your Teacher. Your existing progress is safe." class="locked-mission__info-text" />
                </ui:VisualElement>
                <ui:VisualElement name="details-panel" class="locked-mission__details ds-card ds-card--flush">
                    <ui:Label text="Mission Status" class="locked-mission__panel-heading" />
                    <ui:Label text="Here is exactly what is standing between you and this mission." class="locked-mission__panel-subheading" />
                    <ui:VisualElement name="details-list" class="locked-mission__details-list">
                        <ui:VisualElement class="locked-mission__detail-row"><ui:VisualElement class="ds-icon ds-icon--flag locked-mission__detail-row-icon" /><ui:VisualElement class="locked-mission__detail-row-copy"><ui:Label text="Prerequisite" class="locked-mission__detail-row-label" /><ui:Label name="detail-prerequisite" text="Prerequisite complete — no additional missions required." class="locked-mission__detail-row-value" /></ui:VisualElement></ui:VisualElement>
                        <ui:VisualElement class="locked-mission__detail-row"><ui:VisualElement class="ds-icon ds-icon--info locked-mission__detail-row-icon" /><ui:VisualElement class="locked-mission__detail-row-copy"><ui:Label text="Classroom Publication" class="locked-mission__detail-row-label" /><ui:Label name="detail-classroom" text="Waiting for classroom release" class="locked-mission__detail-row-value" /></ui:VisualElement></ui:VisualElement>
                        <ui:VisualElement class="locked-mission__detail-row locked-mission__detail-row--last"><ui:VisualElement class="ds-icon ds-icon--wifi locked-mission__detail-row-icon" /><ui:VisualElement class="locked-mission__detail-row-copy"><ui:Label text="Download &amp; Offline" class="locked-mission__detail-row-label" /><ui:Label name="detail-download" text="Downloaded • Available offline" class="locked-mission__detail-row-value" /></ui:VisualElement></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="locked-mission__actions"><ui:Button name="action-button" text="" class="ds-btn ds-btn--ghost locked-mission__action-primary"><ui:Label name="action-label" text="Back to Missions" class="locked-mission__action-primary-label" /><ui:VisualElement name="action-icon" class="ds-icon ds-icon--arrow-left locked-mission__action-primary-icon" /></ui:Button></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
