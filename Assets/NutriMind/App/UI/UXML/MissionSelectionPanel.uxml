<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Packages/com.sinanata.designsystem/Resources/UI/Styles/DesignSystem/DesignSystem.uss" />
    <Style src="project://database/Assets/NutriMind/App/UI/USS/NutriMindTheme.uss" />
    <Style src="project://database/Assets/NutriMind/App/UI/USS/Shared/AppScreenContent.uss" />
    <Style src="project://database/Assets/NutriMind/App/UI/USS/MissionSelectionPanel.uss" />

    <ui:VisualElement
        name="mission-selection-root"
        class="ds-root theme-nutrimind app-screen-content mission-selection">

        <!-- ===== ROUTE INTRO ===== -->
        <ui:VisualElement name="mission-selection-intro" class="mission-selection__intro">
            <ui:Button name="back-button" text="" class="ds-btn ds-btn--ghost mission-selection__back" tooltip="Back">
                <ui:VisualElement class="ds-icon ds-icon--arrow-left mission-selection__back-icon" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label name="term-heading" text="Term 1: Pages of the Nation" class="mission-selection__term-heading" />
        </ui:VisualElement>

        <!-- ===== MAIN BODY (list + detail) ===== -->
        <ui:VisualElement name="mission-body" class="mission-selection__body">
            <ui:VisualElement name="mission-list-panel" class="mission-selection__list-panel">
                <ui:ScrollView name="mission-scroll" class="mission-selection__scroll"
                               mode="Vertical"
                               horizontal-scroller-visibility="Hidden"
                               vertical-scroller-visibility="Auto"
                               mouse-wheel-scroll-size="72"
                               vertical-page-size="0.85"
                               touch-scroll-type="Clamped"
                               focusable="true">
                    <ui:VisualElement name="mission-list" class="mission-selection__list">

                        <ui:Button name="mission-item-1" class="ds-card mission-selection__item mission-selection__item--completed">
                            <ui:VisualElement class="mission-selection__item-badge mission-selection__item-badge--completed">
                                <ui:Label text="1" class="mission-selection__item-badge-label" />
                            </ui:VisualElement>
                            <ui:Label name="mission-1-title" text="The Festival Storybook Rescue" class="mission-selection__item-title" />
                            <ui:VisualElement class="mission-selection__item-status mission-selection__item-status--completed">
                                <ui:VisualElement class="ds-icon ds-icon--check mission-selection__item-status-icon" />
                                <ui:Label text="Completed" class="mission-selection__item-status-label" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="mission-item-2" class="ds-card mission-selection__item mission-selection__item--progress is-selected">
                            <ui:VisualElement class="mission-selection__item-badge mission-selection__item-badge--progress">
                                <ui:Label text="2" class="mission-selection__item-badge-label" />
                            </ui:VisualElement>
                            <ui:Label name="mission-2-title" text="The Bell of Seven Moments" class="mission-selection__item-title mission-selection__item-title--active" />
                            <ui:VisualElement class="mission-selection__item-status mission-selection__item-status--progress">
                                <ui:VisualElement class="mission-selection__mini-ring">
                                    <ui:VisualElement class="mission-selection__mini-ring-track" />
                                    <ui:VisualElement class="mission-selection__mini-ring-fill" />
                                </ui:VisualElement>
                                <ui:Label text="In Progress" class="mission-selection__item-status-label" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="mission-item-3" class="ds-card mission-selection__item mission-selection__item--available">
                            <ui:VisualElement class="mission-selection__item-badge mission-selection__item-badge--available">
                                <ui:Label text="3" class="mission-selection__item-badge-label" />
                            </ui:VisualElement>
                            <ui:Label name="mission-3-title" text="The Hall of Speaking Sounds" class="mission-selection__item-title" />
                            <ui:VisualElement class="mission-selection__item-status mission-selection__item-status--available">
                                <ui:VisualElement class="mission-selection__available-ring" />
                                <ui:Label text="Available" class="mission-selection__item-status-label" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="mission-item-4" class="ds-card mission-selection__item mission-selection__item--locked mission-selection__item--locked-prerequisite">
                            <ui:VisualElement class="mission-selection__item-badge mission-selection__item-badge--locked">
                                <ui:VisualElement class="ds-icon ds-icon--lock mission-selection__item-badge-lock" />
                            </ui:VisualElement>
                            <ui:Label name="mission-4-title" text="The Newsroom of True Pages" class="mission-selection__item-title mission-selection__item-title--locked" />
                            <ui:VisualElement class="mission-selection__item-status mission-selection__item-status--locked">
                                <ui:VisualElement class="ds-icon ds-icon--lock mission-selection__item-status-icon mission-selection__item-status-icon--locked" />
                                <ui:Label text="Prerequisite Locked" class="mission-selection__item-status-label" />
                            </ui:VisualElement>
                        </ui:Button>

                        <ui:Button name="mission-item-5" class="ds-card mission-selection__item mission-selection__item--locked mission-selection__item--locked-teacher">
                            <ui:VisualElement class="mission-selection__item-badge mission-selection__item-badge--locked">
                                <ui:VisualElement class="ds-icon ds-icon--lock mission-selection__item-badge-lock" />
                            </ui:VisualElement>
                            <ui:Label name="mission-5-title" text="The Grand Holiday Chronicle" class="mission-selection__item-title mission-selection__item-title--locked" />
                            <ui:VisualElement class="mission-selection__item-status mission-selection__item-status--locked">
                                <ui:VisualElement class="ds-icon ds-icon--lock mission-selection__item-status-icon mission-selection__item-status-icon--locked" />
                                <ui:Label text="Teacher Locked" class="mission-selection__item-status-label" />
                            </ui:VisualElement>
                        </ui:Button>

                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>

            <ui:VisualElement name="mission-detail-panel" class="mission-selection__detail-panel ds-card ds-card--flush">
                <ui:ScrollView
                    name="mission-detail-scroll"
                    class="mission-selection__detail-scroll"
                    mode="Vertical"
                    horizontal-scroller-visibility="Hidden"
                    vertical-scroller-visibility="Auto"
                    mouse-wheel-scroll-size="72"
                    vertical-page-size="0.85"
                    touch-scroll-type="Clamped"
                    focusable="true">
                    <ui:VisualElement name="mission-detail" class="mission-selection__detail">

                        <ui:VisualElement class="mission-selection__detail-header">
                            <ui:Label name="detail-title" text="The Bell of Seven Moments" class="mission-selection__detail-title" />
                            <ui:Label name="detail-description" text="The memorial bell rings seven times, but every witness remembers the order differently. A young bell keeper is blamed unfairly because of a misleading poster. The Pathfinder investigates the seven moments, corrects the record, and restores the bell’s true story." class="mission-selection__detail-desc" />

                            <ui:VisualElement name="detail-status" class="mission-selection__detail-status mission-selection__detail-status--progress">
                                <ui:VisualElement name="detail-status-icon" class="mission-selection__mini-ring mission-selection__detail-status-icon">
                                    <ui:VisualElement class="mission-selection__mini-ring-track" />
                                    <ui:VisualElement class="mission-selection__mini-ring-fill" />
                                </ui:VisualElement>
                                <ui:Label name="detail-status-label" text="In Progress" class="mission-selection__detail-status-label" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="learning-goal" class="mission-selection__info-card mission-selection__goal">
                            <ui:VisualElement class="mission-selection__goal-header">
                                <ui:VisualElement class="ds-icon ds-icon--target mission-selection__goal-icon" />
                                <ui:Label text="Learning Goal" class="mission-selection__goal-heading" />
                            </ui:VisualElement>
                            <ui:Label name="detail-learning-goal" text="Sequencing at least seven events; main idea and summary; progressive tenses; adverbs of manner and time; character feelings and traits; prediction, conclusion, real-life possibility; analogy and dictionary use; formal tone; compound-complex sentences; visual purpose and stereotypes." class="mission-selection__goal-text" />
                        </ui:VisualElement>

                        <ui:VisualElement name="progress-section" class="mission-selection__info-card mission-selection__progress-section">
                            <ui:Label text="Your Progress" class="mission-selection__section-heading" />

                            <ui:VisualElement class="mission-selection__stat-row">
                                <ui:VisualElement class="mission-selection__stat-row-head">
                                    <ui:Label text="Areas" class="mission-selection__stat-label" />
                                    <ui:Label name="detail-areas-progress" text="2 / 3" class="mission-selection__stat-count" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mission-selection__stat-track">
                                    <ui:VisualElement name="detail-areas-fill" class="mission-selection__stat-fill" />
                                </ui:VisualElement>
                            </ui:VisualElement>

                            <ui:VisualElement class="mission-selection__stat-row mission-selection__stat-row--last">
                                <ui:VisualElement class="mission-selection__stat-row-head">
                                    <ui:Label text="Collectibles" class="mission-selection__stat-label" />
                                    <ui:Label name="detail-collectibles-progress" text="2 / 3" class="mission-selection__stat-count" />
                                </ui:VisualElement>
                                <ui:VisualElement class="mission-selection__stat-track">
                                    <ui:VisualElement name="detail-collectibles-fill" class="mission-selection__stat-fill mission-selection__stat-fill--collectibles" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="mission-info-section" class="mission-selection__info-card mission-selection__mission-info">
                            <ui:Label text="Mission Status" class="mission-selection__section-heading" />

                            <ui:VisualElement class="mission-selection__info-row">
                                <ui:VisualElement class="ds-icon ds-icon--flag mission-selection__info-row-icon" />
                                <ui:Label name="detail-prerequisite" text="No prerequisite" class="mission-selection__info-row-text" />
                            </ui:VisualElement>

                            <ui:VisualElement class="mission-selection__info-row">
                                <ui:VisualElement class="ds-icon ds-icon--info mission-selection__info-row-icon" />
                                <ui:Label name="detail-classroom" text="Published to your classroom" class="mission-selection__info-row-text" />
                            </ui:VisualElement>

                            <ui:VisualElement class="mission-selection__info-row mission-selection__info-row--last">
                                <ui:VisualElement class="ds-icon ds-icon--wifi mission-selection__info-row-icon" />
                                <ui:Label name="detail-downloaded" text="Downloaded • Available offline" class="mission-selection__info-row-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:Button name="primary-action-button" text="" class="ds-btn ds-btn--primary mission-selection__primary-action">
                    <ui:Label name="primary-action-label" text="Continue Mission" class="mission-selection__primary-action-label" />
                    <ui:VisualElement name="primary-action-icon" class="ds-icon ds-icon--chevron-right mission-selection__primary-action-icon" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
